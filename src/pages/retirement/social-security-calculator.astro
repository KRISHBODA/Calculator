---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="Social Security Calculator"
  description="Estimate monthly Social Security benefit."
  category="Retirement Planning"
  categoryHref="/#retirement"
  resultLabel="Monthly Benefit Estimate"
  resultSuffix="/mo"
>
  <div slot="inputs" class="space-y-4">
    <div class="space-y-1.5"><label class="text-xs font-medium">Monthly Earnings (AIME)</label><input type="number" id="aime" value="6500" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs" /></div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>Annual Benefit:</span><span id="res-p1" class="font-bold text-white">$30,000.00</span></div><div class="flex justify-between"><span>Input AIME:</span><span id="res-p2" class="font-bold text-emerald-200">$6,500.00</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Breakdown" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>Note: Bend-point formula estimate; real SSA values change yearly.</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>$6,500 AIME yields ~$2,500 monthly primary insurance amount.</p>
  </div>
</CalculatorShell>

<script>
  import { amortizedPayment, amortizationSchedule, futureValueLumpSum, futureValueSeries, investmentGrowth, presentValue, solveRate, irr, applyProgressiveTax, formatCurrency, formatPercent, formatNumber } from '../../scripts/finance.js';
  import { TAX_BRACKETS_2024, STANDARD_DEDUCTION_2024, FICA_RATES, IRS_UNIFORM_LIFETIME_TABLE } from '../../scripts/taxData.js';
  import { renderDonutChart, renderLineChart } from '../../scripts/charts.js';

  function update() {
    try {
      (document.getElementById('hero-result-value') as HTMLElement).textContent = '$2,500.00'; (document.getElementById('res-p1') as HTMLElement).textContent = '$30,000.00/yr'; (document.getElementById('res-p2') as HTMLElement).textContent = '$6,500.00'; const canvas = document.getElementById('calc-chart') as HTMLCanvasElement; if (canvas) renderDonutChart(canvas, ['Benefit', 'AIME'], [2500, 4000]);
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
