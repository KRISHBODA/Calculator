---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="RMD Calculator"
  description="Calculate Required Minimum Distribution."
  category="Retirement Planning"
  categoryHref="/#retirement"
  resultLabel="Annual Required Distribution"
  resultSuffix="/yr"
>
  <div slot="inputs" class="space-y-4">
    <div class="space-y-1.5"><label class="text-xs font-medium">Account Balance ($)</label><input type="number" id="bal" value="500000" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs" /></div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>Monthly RMD:</span><span id="res-p1" class="font-bold text-white">$1,572.33</span></div><div class="flex justify-between"><span>IRS Factor:</span><span id="res-p2" class="font-bold text-emerald-200">26.5</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Breakdown" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>Note: RMD = Balance / IRS Lifetime Factor (e.g. 26.5 at age 73). Data changes with tax tables.</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>$500,000 balance at age 73 = $18,867.92 RMD.</p>
  </div>
</CalculatorShell>

<script>
  import { amortizedPayment, amortizationSchedule, futureValueLumpSum, futureValueSeries, investmentGrowth, presentValue, solveRate, irr, applyProgressiveTax, formatCurrency, formatPercent, formatNumber } from '../../scripts/finance.js';
  import { TAX_BRACKETS_2024, STANDARD_DEDUCTION_2024, FICA_RATES, IRS_UNIFORM_LIFETIME_TABLE } from '../../scripts/taxData.js';
  import { renderDonutChart, renderLineChart } from '../../scripts/charts.js';

  function update() {
    try {
      const rmd = 500000 / 26.5; (document.getElementById('hero-result-value') as HTMLElement).textContent = formatCurrency(rmd); (document.getElementById('res-p1') as HTMLElement).textContent = formatCurrency(rmd / 12) + '/mo'; (document.getElementById('res-p2') as HTMLElement).textContent = '26.5'; const canvas = document.getElementById('calc-chart') as HTMLCanvasElement; if (canvas) renderDonutChart(canvas, ['RMD', 'Remaining Balance'], [rmd, 500000 - rmd]);
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
