---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="RMD Calculator (Required Minimum Distribution)"
  description="Calculate mandatory IRS Required Minimum Distributions (RMD) from Traditional IRAs and 401(k) accounts based on official IRS Uniform Lifetime Table factors."
  category="Retirement Planning"
  categoryHref="/#retirement"
  resultLabel="Mandatory Annual RMD Amount"
  resultSuffix="total"
>
  <div slot="inputs" class="space-y-4">
    <div class="grid grid-cols-2 gap-3 border-b border-[var(--rule-light)] pb-3 text-xs">
      <div>
        <label for="age-val" class="block text-[var(--ink-soft)] mb-1">Current Age (73+)</label>
        <input type="number" id="age-val" value="75" min="73" max="115" step="1" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="balance-val" class="block text-[var(--ink-soft)] mb-1">Dec 31 Account Balance ($)</label>
        <input type="number" id="balance-val" value="500000" min="1000" step="10000" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-[var(--ink)]" />
      </div>
    </div>

    <div class="space-y-1 text-xs">
      <label for="table-type" class="block font-semibold text-[var(--ink)] mb-1">IRS Life Expectancy Table</label>
      <select id="table-type" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs text-[var(--ink)]">
        <option value="uniform" selected>Uniform Lifetime Table (Standard Unmarried / Spouse <= 10 yrs younger)</option>
        <option value="joint">Joint Life Table (Spouse > 10 yrs younger)</option>
      </select>
    </div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>IRS Distribution Period Factor:</span><span id="res-p1" class="font-bold text-white">24.6 years</span></div>
    <div class="flex justify-between"><span>Mandatory Annual RMD Distribution:</span><span id="res-p2" class="font-bold text-emerald-200">$0.00</span></div>
    <div class="flex justify-between"><span>Equivalent Monthly Distribution:</span><span id="res-p3" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between pt-1 border-t border-emerald-800/60 font-bold text-white"><span>Remaining Account Balance After RMD:</span><span id="res-p4">$0.00</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Account Balance vs Mandatory RMD" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>RMD = Dec 31 Account Balance / IRS Life Expectancy Factor. Failure to withdraw RMD triggers 25% IRS excise tax penalty.</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>Age 75 with $500,000 IRA balance uses IRS Uniform factor 24.6, requiring a $20,325 annual minimum distribution ($1,694/mo).</p>
  </div>
</CalculatorShell>

<script>
  import { formatCurrency } from '../../scripts/finance.js';
  import { renderDonutChart } from '../../scripts/charts.js';
  import { IRS_UNIFORM_LIFETIME_TABLE } from '../../scripts/taxData.js';

  function update() {
    try {
      const age = parseInt((document.getElementById('age-val') as HTMLInputElement)?.value || '75');
      const balance = parseFloat((document.getElementById('balance-val') as HTMLInputElement)?.value || '500000');

      // Lookup IRS factor
      const irsFactor = IRS_UNIFORM_LIFETIME_TABLE[age] || Math.max(2.0, 24.6 - (age - 75) * 0.8);

      const annualRmd = balance / irsFactor;
      const monthlyRmd = annualRmd / 12;
      const remainingBalance = Math.max(0, balance - annualRmd);

      (document.getElementById('hero-result-value') as HTMLElement).textContent = formatCurrency(annualRmd);
      (document.getElementById('res-p1') as HTMLElement).textContent = `${irsFactor.toFixed(1)} years`;
      (document.getElementById('res-p2') as HTMLElement).textContent = formatCurrency(annualRmd);
      (document.getElementById('res-p3') as HTMLElement).textContent = formatCurrency(monthlyRmd) + '/mo';
      (document.getElementById('res-p4') as HTMLElement).textContent = formatCurrency(remainingBalance);

      const canvas = document.getElementById('calc-chart') as HTMLCanvasElement;
      if (canvas) {
        renderDonutChart(canvas, ['Remaining Tax-Deferred Balance', 'Mandatory Annual RMD'], [remainingBalance, annualRmd]);
      }
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
