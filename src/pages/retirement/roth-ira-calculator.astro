---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="Roth IRA Calculator"
  description="Calculate tax-free Roth IRA growth, total contributions vs earnings, and compare Roth IRA tax advantages against a Traditional IRA."
  category="Retirement Planning"
  categoryHref="/#retirement"
  resultLabel="Tax-Free Roth IRA Balance"
  resultSuffix="total"
>
  <div slot="inputs" class="space-y-4">
    <div class="grid grid-cols-2 gap-3 border-b border-[var(--rule-light)] pb-3 text-xs">
      <div>
        <label for="current-age" class="block text-[var(--ink-soft)] mb-1">Current Age</label>
        <input type="number" id="current-age" value="30" min="18"  step="1" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="retire-age" class="block text-[var(--ink-soft)] mb-1">Retirement Age</label>
        <input type="number" id="retire-age" value="65" min="40"  step="1" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-[var(--ink)]" />
      </div>
    </div>

    <div class="grid grid-cols-2 gap-3 border-b border-[var(--rule-light)] pb-3 text-xs">
      <div>
        <label for="balance-val" class="block text-[var(--ink-soft)] mb-1">Current Roth IRA Balance ($)</label>
        <input type="number" id="balance-val" value="15000" min="0" step="1000" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="contrib-val" class="block text-[var(--ink-soft)] mb-1">Annual Contribution ($)</label>
        <input type="number" id="contrib-val" value="7000" min="0"  step="250" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-[var(--ink)]" />
      </div>
    </div>

    <div class="grid grid-cols-3 gap-2 text-xs">
      <div>
        <label for="return-rate" class="block text-[var(--ink-soft)] mb-1">Return Rate (%)</label>
        <input type="number" id="return-rate" value="7.0" min="0"  step="0.1" class="w-full p-1 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="cur-tax" class="block text-[var(--ink-soft)] mb-1">Current Tax (%)</label>
        <input type="number" id="cur-tax" value="22" min="0"  step="1" class="w-full p-1 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="ret-tax" class="block text-[var(--ink-soft)] mb-1">Retire Tax (%)</label>
        <input type="number" id="ret-tax" value="15" min="0"  step="1" class="w-full p-1 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
    </div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>Starting Balance:</span><span id="res-p1" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between"><span>Total Contributions Paid:</span><span id="res-p2" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between"><span>Total Tax-Free Earnings:</span><span id="res-p3" class="font-bold text-emerald-200">$0.00</span></div>
    <div class="flex justify-between pt-1 border-t border-emerald-800/60 font-bold text-white"><span>Traditional IRA Equivalent (Post-Tax):</span><span id="res-p4">$0.00</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Roth IRA Capital & Tax-Free Growth" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>Roth IRA contributions are made after-tax, allowing 100% tax-free growth and tax-free withdrawals in retirement.</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>Age 30 with $15,000 balance + $7,000/year at 7% return yields $1,190,402 tax-free at age 65 ($930,402 pure tax-free growth).</p>
  </div>
</CalculatorShell>

<script>
  import { formatCurrency } from '../../scripts/finance.js';
  import { renderDonutChart } from '../../scripts/charts.js';

  function update() {
    try {
      const curAge = parseInt((document.getElementById('current-age') as HTMLInputElement)?.value || '30');
      const retAge = parseInt((document.getElementById('retire-age') as HTMLInputElement)?.value || '65');

      const startBalance = parseFloat((document.getElementById('balance-val') as HTMLInputElement)?.value || '15000');
      const annualContrib = parseFloat((document.getElementById('contrib-val') as HTMLInputElement)?.value || '7000');

      const returnRate = parseFloat((document.getElementById('return-rate') as HTMLInputElement)?.value || '7.0') / 100;
      const retTax = parseFloat((document.getElementById('ret-tax') as HTMLInputElement)?.value || '15') / 100;

      const totalYears = Math.max(1, retAge - curAge);
      const rMo = returnRate / 12;
      const moContrib = annualContrib / 12;

      let rothBalance = startBalance;
      let totalContribs = 0;

      for (let m = 0; m < totalYears * 12; m++) {
        rothBalance = (rothBalance + moContrib) * (1 + rMo);
        totalContribs += moContrib;
      }

      const totalTaxFreeGrowth = Math.max(0, rothBalance - startBalance - totalContribs);
      const tradIraPostTax = rothBalance * (1 - retTax);

      (document.getElementById('hero-result-value') as HTMLElement).textContent = formatCurrency(rothBalance);
      (document.getElementById('res-p1') as HTMLElement).textContent = formatCurrency(startBalance);
      (document.getElementById('res-p2') as HTMLElement).textContent = formatCurrency(totalContribs);
      (document.getElementById('res-p3') as HTMLElement).textContent = formatCurrency(totalTaxFreeGrowth);
      (document.getElementById('res-p4') as HTMLElement).textContent = formatCurrency(tradIraPostTax);

      const canvas = document.getElementById('calc-chart') as HTMLCanvasElement;
      if (canvas) {
        renderDonutChart(canvas, ['Starting Balance', 'Total Contributions', 'Tax-Free Investment Growth'], [startBalance, totalContribs, totalTaxFreeGrowth]);
      }
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
