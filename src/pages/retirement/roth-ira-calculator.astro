---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="Roth IRA Calculator"
  description="Calculate tax-free Roth IRA earnings."
  category="Retirement Planning"
  categoryHref="/#retirement"
  resultLabel="Tax-Free Roth Balance"
  resultSuffix=""
>
  <div slot="inputs" class="space-y-4">
    <div class="space-y-1.5"><label class="text-xs font-medium">Monthly Contribution ($)</label><input type="number" id="pmt" value="583" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs" /></div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>Total Contributions:</span><span id="res-p1" class="font-bold text-white">$209,880.00</span></div><div class="flex justify-between"><span>Tax-Free Growth:</span><span id="res-p2" class="font-bold text-emerald-200">$570,000.00</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Breakdown" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>Roth IRA tax-free growth.</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>$583/mo ($7,000/yr) at 8% over 30 years = ~$780,000 tax-free.</p>
  </div>
</CalculatorShell>

<script>
  import { amortizedPayment, amortizationSchedule, futureValueLumpSum, futureValueSeries, investmentGrowth, presentValue, solveRate, irr, applyProgressiveTax, formatCurrency, formatPercent, formatNumber } from '../../scripts/finance.js';
  import { TAX_BRACKETS_2024, STANDARD_DEDUCTION_2024, FICA_RATES, IRS_UNIFORM_LIFETIME_TABLE } from '../../scripts/taxData.js';
  import { renderDonutChart, renderLineChart } from '../../scripts/charts.js';

  function update() {
    try {
      const fv = futureValueSeries(583, 8.0, 30, 12); (document.getElementById('hero-result-value') as HTMLElement).textContent = formatCurrency(fv); (document.getElementById('res-p1') as HTMLElement).textContent = '$209,880.00'; (document.getElementById('res-p2') as HTMLElement).textContent = formatCurrency(fv - 209880); const canvas = document.getElementById('calc-chart') as HTMLCanvasElement; if (canvas) renderDonutChart(canvas, ['Contributions', 'Tax-Free Growth'], [209880, fv - 209880]);
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
