---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="Pension Calculator"
  description="Calculate monthly defined benefit pension income based on final average salary, total years of service, and benefit multiplier percentages."
  category="Retirement Planning"
  categoryHref="/#retirement"
  resultLabel="Monthly Pension Income"
  resultSuffix="/mo"
>
  <div slot="inputs" class="space-y-4">
    <div class="space-y-1.5 border-b border-[var(--rule-light)] pb-3">
      <label for="salary-val" class="block text-xs font-semibold text-[var(--ink)]">1. Final Average Salary ($/yr)</label>
      <input type="number" id="salary-val" value="90000" min="10000" step="5000" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs text-[var(--ink)]" />
    </div>

    <div class="grid grid-cols-2 gap-3 border-b border-[var(--rule-light)] pb-3 text-xs">
      <div>
        <label for="service-yrs" class="block text-[var(--ink-soft)] mb-1">Years of Service</label>
        <input type="number" id="service-yrs" value="25" min="1"  step="1" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="multiplier-pct" class="block text-[var(--ink-soft)] mb-1">Benefit Multiplier (%)</label>
        <input type="number" id="multiplier-pct" value="2.0" min="0.5"  step="0.1" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
    </div>

    <div class="grid grid-cols-2 gap-3 text-xs">
      <div>
        <label for="retire-age" class="block text-[var(--ink-soft)] mb-1">Retirement Age</label>
        <input type="number" id="retire-age" value="62" min="50"  step="1" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="lump-sum" class="block text-[var(--ink-soft)] mb-1">Lump Sum Offer ($)</label>
        <input type="number" id="lump-sum" value="450000" min="0" step="10000" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-[var(--ink)]" />
      </div>
    </div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>Annual Pension Benefit:</span><span id="res-p1" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between"><span>Monthly Pension Benefit:</span><span id="res-p2" class="font-bold text-emerald-200">$0.00</span></div>
    <div class="flex justify-between"><span>Pension Income Replacement Ratio:</span><span id="res-p3" class="font-bold text-white">0.0%</span></div>
    <div class="flex justify-between pt-1 border-t border-emerald-800/60 font-bold text-white"><span>Break-Even Horizon vs Lump Sum:</span><span id="res-p4">0.0 years</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Pension Replacement vs Salary" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>Annual Pension = Final Average Salary * Years of Service * Multiplier %. Monthly Pension = Annual Pension / 12.</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>$90,000 final average salary with 25 years of service at a 2.0% multiplier yields $45,000/year pension ($3,750/month, replacing 50% of pre-retirement salary).</p>
  </div>
</CalculatorShell>

<script>
  import { formatCurrency, formatPercent } from '../../scripts/finance.js';
  import { renderDonutChart } from '../../scripts/charts.js';

  function update() {
    try {
      const salary = parseFloat((document.getElementById('salary-val') as HTMLInputElement)?.value || '90000');
      const serviceYrs = parseInt((document.getElementById('service-yrs') as HTMLInputElement)?.value || '25');
      const multiplierPct = parseFloat((document.getElementById('multiplier-pct') as HTMLInputElement)?.value || '2.0');
      const lumpSum = parseFloat((document.getElementById('lump-sum') as HTMLInputElement)?.value || '450000');

      const annualPension = salary * serviceYrs * (multiplierPct / 100);
      const monthlyPension = annualPension / 12;
      const replacementRatio = salary > 0 ? (annualPension / salary) * 100 : 0;

      const breakEvenYears = annualPension > 0 ? lumpSum / annualPension : 0;

      (document.getElementById('hero-result-value') as HTMLElement).textContent = formatCurrency(monthlyPension);
      (document.getElementById('res-p1') as HTMLElement).textContent = formatCurrency(annualPension) + '/yr';
      (document.getElementById('res-p2') as HTMLElement).textContent = formatCurrency(monthlyPension) + '/mo';
      (document.getElementById('res-p3') as HTMLElement).textContent = formatPercent(replacementRatio, 1);
      (document.getElementById('res-p4') as HTMLElement).textContent = `${breakEvenYears.toFixed(1)} years`;

      const canvas = document.getElementById('calc-chart') as HTMLCanvasElement;
      if (canvas) {
        renderDonutChart(canvas, ['Annual Pension Benefit', 'Remaining Salary Portion'], [annualPension, Math.max(0, salary - annualPension)]);
      }
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
