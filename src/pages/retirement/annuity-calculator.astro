---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="Annuity Calculator"
  description="Calculate fixed annuity accumulation growth, guaranteed interest earnings, and end-of-term contract value."
  category="Retirement Planning"
  categoryHref="/#retirement"
  resultLabel="Accumulated Annuity Value"
  resultSuffix="total"
>
  <div slot="inputs" class="space-y-4">
    <div class="space-y-1.5 border-b border-[var(--rule-light)] pb-3">
      <label for="initial-val" class="block text-xs font-semibold text-[var(--ink)]">1. Initial Annuity Premium Deposit ($)</label>
      <input type="number" id="initial-val" value="25000" min="1000" step="2500" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs text-[var(--ink)]" />
    </div>

    <div class="grid grid-cols-2 gap-3 border-b border-[var(--rule-light)] pb-3 text-xs">
      <div>
        <label for="premium-val" class="block text-[var(--ink-soft)] mb-1">Recurring Premium ($)</label>
        <input type="number" id="premium-val" value="200" min="0" step="50" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="premium-freq" class="block text-[var(--ink-soft)] mb-1">Premium Frequency</label>
        <select id="premium-freq" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-[var(--ink)] font-mono text-xs">
          <option value="monthly" selected>Monthly</option>
          <option value="annually">Annually</option>
        </select>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-3 text-xs">
      <div>
        <label for="years-val" class="block text-[var(--ink-soft)] mb-1">Accumulation Term (Yrs)</label>
        <input type="number" id="years-val" value="15" min="1"  step="1" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="rate-val" class="block text-[var(--ink-soft)] mb-1">Guaranteed Rate (%)</label>
        <input type="number" id="rate-val" value="5.5" min="0.1"  step="0.1" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
    </div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>Initial Deposit:</span><span id="res-p1" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between"><span>Total Premium Deposits:</span><span id="res-p2" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between"><span>Guaranteed Interest Earned:</span><span id="res-p3" class="font-bold text-emerald-200">$0.00</span></div>
    <div class="flex justify-between pt-1 border-t border-emerald-800/60 font-bold text-white"><span>Total Contract Value:</span><span id="res-p4">$0.00</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Annuity Accumulation Components" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>Annuity Accumulation FV = Principal * (1+r)^t + Premium * [((1+r)^t - 1) / r]. Guaranteed tax-deferred growth phase.</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>$25,000 initial premium + $200/month at 5.5% guaranteed interest over 15 years accumulates $108,124 contract value ($61,000 premiums + $47,124 interest).</p>
  </div>
</CalculatorShell>

<script>
  import { formatCurrency } from '../../scripts/finance.js';
  import { renderDonutChart } from '../../scripts/charts.js';

  function update() {
    try {
      const initial = parseFloat((document.getElementById('initial-val') as HTMLInputElement)?.value || '25000');
      const premium = parseFloat((document.getElementById('premium-val') as HTMLInputElement)?.value || '200');
      const freq = (document.getElementById('premium-freq') as HTMLSelectElement)?.value || 'monthly';

      const yrs = parseInt((document.getElementById('years-val') as HTMLInputElement)?.value || '15');
      const rate = parseFloat((document.getElementById('rate-val') as HTMLInputElement)?.value || '5.5');

      const rDecimal = rate / 100;
      const periodsPerYr = freq === 'monthly' ? 12 : 1;
      const totalPeriods = yrs * periodsPerYr;
      const rPerPeriod = rDecimal / periodsPerYr;

      let balance = initial;
      const totalPremiums = premium * totalPeriods;

      for (let i = 0; i < totalPeriods; i++) {
        balance = (balance + premium) * (1 + rPerPeriod);
      }

      const totalInterest = Math.max(0, balance - initial - totalPremiums);

      (document.getElementById('hero-result-value') as HTMLElement).textContent = formatCurrency(balance);
      (document.getElementById('res-p1') as HTMLElement).textContent = formatCurrency(initial);
      (document.getElementById('res-p2') as HTMLElement).textContent = formatCurrency(totalPremiums);
      (document.getElementById('res-p3') as HTMLElement).textContent = formatCurrency(totalInterest);
      (document.getElementById('res-p4') as HTMLElement).textContent = formatCurrency(balance);

      const canvas = document.getElementById('calc-chart') as HTMLCanvasElement;
      if (canvas) {
        renderDonutChart(canvas, ['Initial Premium', 'Recurring Premiums', 'Guaranteed Interest'], [initial, totalPremiums, totalInterest]);
      }
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
