---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="IRA Calculator"
  description="Compare Traditional vs Roth IRA."
  category="Retirement Planning"
  categoryHref="/#retirement"
  resultLabel="Traditional IRA Balance"
  resultSuffix=""
>
  <div slot="inputs" class="space-y-4">
    <div class="space-y-1.5"><label class="text-xs font-medium">Monthly Contribution ($)</label><input type="number" id="pmt" value="500" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs" /></div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>Total Contributions:</span><span id="res-p1" class="font-bold text-white">$150,000.00</span></div><div class="flex justify-between"><span>Tax-Deferred Growth:</span><span id="res-p2" class="font-bold text-emerald-200">$255,000.00</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Breakdown" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>Pre-tax IRA accumulation.</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>$500/mo at 7% over 25 years = ~$405,000.</p>
  </div>
</CalculatorShell>

<script>
  import { amortizedPayment, amortizationSchedule, futureValueLumpSum, futureValueSeries, investmentGrowth, presentValue, solveRate, irr, applyProgressiveTax, formatCurrency, formatPercent, formatNumber } from '../../scripts/finance.js';
  import { TAX_BRACKETS_2024, STANDARD_DEDUCTION_2024, FICA_RATES, IRS_UNIFORM_LIFETIME_TABLE } from '../../scripts/taxData.js';
  import { renderDonutChart, renderLineChart } from '../../scripts/charts.js';

  function update() {
    try {
      const fv = futureValueSeries(500, 7.0, 25, 12); (document.getElementById('hero-result-value') as HTMLElement).textContent = formatCurrency(fv); (document.getElementById('res-p1') as HTMLElement).textContent = '$150,000.00'; (document.getElementById('res-p2') as HTMLElement).textContent = formatCurrency(fv - 150000); const canvas = document.getElementById('calc-chart') as HTMLCanvasElement; if (canvas) renderDonutChart(canvas, ['Contributions', 'Tax-Deferred Interest'], [150000, fv - 150000]);
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
