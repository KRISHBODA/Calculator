---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="Take-Home-Paycheck Calculator"
  description="Calculate net pay after tax and FICA."
  category="Tax & Salary"
  categoryHref="/#tax-and-salary"
  resultLabel="Estimated Net Paycheck"
  resultSuffix="/mo"
>
  <div slot="inputs" class="space-y-4">
    <div class="space-y-1.5"><label class="text-xs font-medium">Gross Monthly Pay ($)</label><input type="number" id="gross" value="6000" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs" /></div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>Total Deductions:</span><span id="res-p1" class="font-bold text-white">$1,350.00</span></div><div class="flex justify-between"><span>FICA Deductions:</span><span id="res-p2" class="font-bold text-emerald-200">$459.00</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Breakdown" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>Net = Gross − Federal Tax − FICA (7.65%) − State Tax.</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>$6,000 monthly gross pay yields ~$4,650 net take-home pay.</p>
  </div>
</CalculatorShell>

<script>
  import { amortizedPayment, amortizationSchedule, futureValueLumpSum, futureValueSeries, investmentGrowth, presentValue, solveRate, irr, applyProgressiveTax, formatCurrency, formatPercent, formatNumber } from '../../scripts/finance.js';
  import { TAX_BRACKETS_2024, STANDARD_DEDUCTION_2024, FICA_RATES, IRS_UNIFORM_LIFETIME_TABLE } from '../../scripts/taxData.js';
  import { renderDonutChart, renderLineChart } from '../../scripts/charts.js';

  function update() {
    try {
      const gross = 6000; const fed = 650; const fica = gross * 0.0765; const state = gross * 0.05; const net = gross - fed - fica - state; (document.getElementById('hero-result-value') as HTMLElement).textContent = formatCurrency(net); (document.getElementById('res-p1') as HTMLElement).textContent = formatCurrency(fed + fica + state) + '/mo'; (document.getElementById('res-p2') as HTMLElement).textContent = formatCurrency(fica) + '/mo'; const canvas = document.getElementById('calc-chart') as HTMLCanvasElement; if (canvas) renderDonutChart(canvas, ['Net Pay', 'Deductions'], [net, fed + fica + state]);
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
