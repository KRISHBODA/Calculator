---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="Estate Tax Calculator"
  description="Calculate federal and state estate tax liability for high net worth estates, applying official IRS lifetime exemption thresholds ($13.61M)."
  category="Tax & Salary"
  categoryHref="/#tax-and-salary"
  resultLabel="Net Federal & State Estate Tax Owed"
  resultSuffix="total"
>
  <div slot="inputs" class="space-y-4">
    <div class="space-y-1.5 border-b border-[var(--rule-light)] pb-3">
      <label for="estate-val" class="block text-xs font-semibold text-[var(--ink)]">1. Total Gross Estate Assets Value ($)</label>
      <input type="number" id="estate-val" value="16000000" min="100000" step="500000" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs text-[var(--ink)]" />
    </div>

    <div class="grid grid-cols-2 gap-3 border-b border-[var(--rule-light)] pb-3 text-xs">
      <div>
        <label for="debts-val" class="block text-[var(--ink-soft)] mb-1">Mortgages & Debts ($)</label>
        <input type="number" id="debts-val" value="500000" min="0" step="50000" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="expenses-val" class="block text-[var(--ink-soft)] mb-1">Admin & Funeral ($)</label>
        <input type="number" id="expenses-val" value="100000" min="0" step="10000" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-[var(--ink)]" />
      </div>
    </div>

    <div class="grid grid-cols-2 gap-3 border-b border-[var(--rule-light)] pb-3 text-xs">
      <div>
        <label for="charity-val" class="block text-[var(--ink-soft)] mb-1">Charitable Bequests ($)</label>
        <input type="number" id="charity-val" value="400000" min="0" step="50000" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="spouse-val" class="block text-[var(--ink-soft)] mb-1">Spousal Deduction ($)</label>
        <input type="number" id="spouse-val" value="0" min="0" step="100000" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-[var(--ink)]" />
      </div>
    </div>

    <div class="grid grid-cols-2 gap-3 text-xs">
      <div>
        <label for="exemption-val" class="block text-[var(--ink-soft)] mb-1">IRS Exemption ($)</label>
        <input type="number" id="exemption-val" value="13610000" min="1000000" step="100000" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="state-rate" class="block text-[var(--ink-soft)] mb-1">State Estate Tax (%)</label>
        <input type="number" id="state-rate" value="4.0" min="0" max="20" step="0.5" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
    </div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>Net Taxable Estate (After Deductions):</span><span id="res-p1" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between"><span>Estate Value Subject to Tax (Over Exemption):</span><span id="res-p2" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between"><span>Federal Estate Tax (Top Rate 40%):</span><span id="res-p3" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between"><span>State Estate Tax:</span><span id="res-p4" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between pt-1 border-t border-emerald-800/60 font-bold text-white"><span>Net Estate Passed to Heirs:</span><span id="res-p5" class="text-emerald-200">$0.00</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Estate Asset Allocation" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>Taxable Estate = Gross Assets − Debts − Admin − Charity − Spouse. Federal Tax = (Taxable Estate − Lifetime Exemption) × 40% top rate.</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>$16,000,000 gross estate with $1,000,000 deductions leaves $15,000,000 net estate. Subtracting $13,610,000 IRS exemption leaves $1,390,000 taxable ($556,000 federal tax + $60,000 state tax, leaving $14.38M to heirs).</p>
  </div>
</CalculatorShell>

<script>
  import { formatCurrency } from '../../scripts/finance.js';
  import { renderDonutChart } from '../../scripts/charts.js';

  function update() {
    try {
      const grossEstate = parseFloat((document.getElementById('estate-val') as HTMLInputElement)?.value || '16000000');
      const debts = parseFloat((document.getElementById('debts-val') as HTMLInputElement)?.value || '500000');
      const expenses = parseFloat((document.getElementById('expenses-val') as HTMLInputElement)?.value || '100000');
      const charity = parseFloat((document.getElementById('charity-val') as HTMLInputElement)?.value || '400000');
      const spouse = parseFloat((document.getElementById('spouse-val') as HTMLInputElement)?.value || '0');

      const exemption = parseFloat((document.getElementById('exemption-val') as HTMLInputElement)?.value || '13610000');
      const stateRate = parseFloat((document.getElementById('state-rate') as HTMLInputElement)?.value || '4.0');

      const totalDeductions = debts + expenses + charity + spouse;
      const netTaxableEstate = Math.max(0, grossEstate - totalDeductions);

      const estateOverExemption = Math.max(0, netTaxableEstate - exemption);
      const fedTax = estateOverExemption * 0.40; // top federal bracket
      const stateTax = netTaxableEstate * (stateRate / 100);
      const totalEstateTax = fedTax + stateTax;

      const netPassedToHeirs = Math.max(0, netTaxableEstate - totalEstateTax);

      (document.getElementById('hero-result-value') as HTMLElement).textContent = formatCurrency(totalEstateTax);
      (document.getElementById('res-p1') as HTMLElement).textContent = formatCurrency(netTaxableEstate);
      (document.getElementById('res-p2') as HTMLElement).textContent = formatCurrency(estateOverExemption);
      (document.getElementById('res-p3') as HTMLElement).textContent = formatCurrency(fedTax);
      (document.getElementById('res-p4') as HTMLElement).textContent = formatCurrency(stateTax);
      (document.getElementById('res-p5') as HTMLElement).textContent = formatCurrency(netPassedToHeirs);

      const canvas = document.getElementById('calc-chart') as HTMLCanvasElement;
      if (canvas) {
        renderDonutChart(canvas, ['Net Assets to Heirs', 'Estate Taxes Owed', 'Debts, Expenses & Charity'], [netPassedToHeirs, totalEstateTax, totalDeductions]);
      }
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
