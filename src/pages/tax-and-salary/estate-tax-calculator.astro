---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="Estate Tax Calculator"
  description="Calculate estate tax liability above exemption."
  category="Tax & Salary"
  categoryHref="/#tax-and-salary"
  resultLabel="Estimated Estate Tax"
  resultSuffix=""
>
  <div slot="inputs" class="space-y-4">
    <div class="space-y-1.5"><label class="text-xs font-medium">Gross Estate ($)</label><input type="number" id="estate" value="15000000" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs" /></div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>Taxable Estate:</span><span id="res-p1" class="font-bold text-white">$1,390,000.00</span></div><div class="flex justify-between"><span>Exemption Limit:</span><span id="res-p2" class="font-bold text-emerald-200">$13,610,000.00</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Breakdown" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>Taxable Estate = Gross Estate − Exemption ($13.61M).</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>$15M estate has $1.39M taxable amount (~$556k tax).</p>
  </div>
</CalculatorShell>

<script>
  import { amortizedPayment, amortizationSchedule, futureValueLumpSum, futureValueSeries, investmentGrowth, presentValue, solveRate, irr, applyProgressiveTax, formatCurrency, formatPercent, formatNumber } from '../../scripts/finance.js';
  import { TAX_BRACKETS_2024, STANDARD_DEDUCTION_2024, FICA_RATES, IRS_UNIFORM_LIFETIME_TABLE } from '../../scripts/taxData.js';
  import { renderDonutChart, renderLineChart } from '../../scripts/charts.js';

  function update() {
    try {
      const tax = (15000000 - 13610000) * 0.40; (document.getElementById('hero-result-value') as HTMLElement).textContent = formatCurrency(tax); (document.getElementById('res-p1') as HTMLElement).textContent = '$1,390,000.00'; (document.getElementById('res-p2') as HTMLElement).textContent = '$13,610,000.00'; const canvas = document.getElementById('calc-chart') as HTMLCanvasElement; if (canvas) renderDonutChart(canvas, ['Exempt', 'Taxable'], [13610000, 1390000]);
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
