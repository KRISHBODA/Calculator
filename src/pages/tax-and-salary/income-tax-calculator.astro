---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="Income Tax Calculator"
  description="Calculate federal income tax owed."
  category="Tax & Salary"
  categoryHref="/#tax-and-salary"
  resultLabel="Federal Income Tax Owed"
  resultSuffix="/yr"
>
  <div slot="inputs" class="space-y-4">
    <div class="space-y-1.5"><label class="text-xs font-medium">Gross Annual Income ($)</label><input type="number" id="gross" value="85000" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs" /></div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>Effective Tax Rate:</span><span id="res-p1" class="font-bold text-white">12.7%</span></div><div class="flex justify-between"><span>Income After Federal Tax:</span><span id="res-p2" class="font-bold text-emerald-200">$74,200.00</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Breakdown" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>Note: Progressive bracket math after standard deduction ($14,600). Data changes with tax laws.</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>$85,000 gross single income yields ~$10,800 federal tax.</p>
  </div>
</CalculatorShell>

<script>
  import { amortizedPayment, amortizationSchedule, futureValueLumpSum, futureValueSeries, investmentGrowth, presentValue, solveRate, irr, applyProgressiveTax, formatCurrency, formatPercent, formatNumber } from '../../scripts/finance.js';
  import { TAX_BRACKETS_2024, STANDARD_DEDUCTION_2024, FICA_RATES, IRS_UNIFORM_LIFETIME_TABLE } from '../../scripts/taxData.js';
  import { renderDonutChart, renderLineChart } from '../../scripts/charts.js';

  function update() {
    try {
      const res = applyProgressiveTax(85000 - 14600, TAX_BRACKETS_2024.single); (document.getElementById('hero-result-value') as HTMLElement).textContent = formatCurrency(res.totalTax); (document.getElementById('res-p1') as HTMLElement).textContent = formatPercent(res.effectiveRate, 1); (document.getElementById('res-p2') as HTMLElement).textContent = formatCurrency(85000 - res.totalTax); const canvas = document.getElementById('calc-chart') as HTMLCanvasElement; if (canvas) renderDonutChart(canvas, ['Tax Owed', 'Net After Tax'], [res.totalTax, 85000 - res.totalTax]);
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
