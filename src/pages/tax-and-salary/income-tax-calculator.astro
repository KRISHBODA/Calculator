---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="Income Tax Calculator"
  description="Calculate federal income tax owed, state tax, FICA payroll taxes, effective tax rate, and net after-tax income across IRS filing statuses."
  category="Tax & Salary"
  categoryHref="/#tax-and-salary"
  resultLabel="Total Federal & FICA Tax Owed"
  resultSuffix="/yr"
>
  <div slot="inputs" class="space-y-4">
    <div class="space-y-1.5 border-b border-[var(--rule-light)] pb-3">
      <label for="gross-val" class="block text-xs font-semibold text-[var(--ink)]">1. Gross Annual Income ($)</label>
      <input type="number" id="gross-val" value="85000" min="5000" step="5000" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs text-[var(--ink)]" />
    </div>

    <div class="grid grid-cols-2 gap-3 border-b border-[var(--rule-light)] pb-3 text-xs">
      <div>
        <label for="status-select" class="block text-[var(--ink-soft)] mb-1">Filing Status</label>
        <select id="status-select" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-[var(--ink)] font-mono text-xs">
          <option value="single" selected>Single</option>
          <option value="married">Married Filing Jointly</option>
          <option value="head">Head of Household</option>
        </select>
      </div>
      <div>
        <label for="state-rate" class="block text-[var(--ink-soft)] mb-1">State Tax Rate (%)</label>
        <input type="number" id="state-rate" value="5.0" min="0"  step="0.5" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
    </div>

    <div class="space-y-2 text-xs">
      <div class="grid grid-cols-2 gap-2">
        <div>
          <label for="pretax-val" class="block text-[var(--ink-soft)] mb-1">Pre-Tax 401(k) ($/yr)</label>
          <input type="number" id="pretax-val" value="4000" min="0" step="500" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-[var(--ink)]" />
        </div>
        <div class="flex items-center space-x-2 pt-4">
          <input type="checkbox" id="fica-toggle" checked class="accent-[var(--green)] cursor-pointer" />
          <label for="fica-toggle" class="text-xs text-[var(--ink)] cursor-pointer">Include FICA (7.65%)</label>
        </div>
      </div>
    </div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>Federal Income Tax Owed:</span><span id="res-p1" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between"><span>FICA Payroll Taxes (SS + Med):</span><span id="res-p2" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between"><span>State Income Tax Owed:</span><span id="res-p3" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between"><span>Effective Total Tax Rate:</span><span id="res-p4" class="font-bold text-emerald-200">0.0%</span></div>
    <div class="flex justify-between pt-1 border-t border-emerald-800/60 font-bold text-white"><span>Net After-Tax Income:</span><span id="res-p5">$0.00</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Gross Income Tax Allocation" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>Taxable Income = Gross Income − Pre-Tax 401(k) − IRS Standard Deduction. Progressive tax brackets apply to taxable income tiers.</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>$85,000 single income with $4,000 401(k) deduction ($66,400 taxable income after $14,600 standard deduction) yields ~$9,850 federal tax + $6,503 FICA tax ($64,597 net take-home).</p>
  </div>
</CalculatorShell>

<script>
  import { applyProgressiveTax, formatCurrency, formatPercent } from '../../scripts/finance.js';
  import { TAX_BRACKETS_2024, STANDARD_DEDUCTION_2024 } from '../../scripts/taxData.js';
  import { renderDonutChart } from '../../scripts/charts.js';

  function update() {
    try {
      const gross = parseFloat((document.getElementById('gross-val') as HTMLInputElement)?.value || '85000');
      const status = (document.getElementById('status-select') as HTMLSelectElement)?.value || 'single';
      const stateRate = parseFloat((document.getElementById('state-rate') as HTMLInputElement)?.value || '5.0');
      const pretax = parseFloat((document.getElementById('pretax-val') as HTMLInputElement)?.value || '4000');
      const includeFica = (document.getElementById('fica-toggle') as HTMLInputElement)?.checked;

      const stdDeduction = (STANDARD_DEDUCTION_2024 as any)[status] || 14600;
      const brackets = (TAX_BRACKETS_2024 as any)[status] || TAX_BRACKETS_2024.single;

      const taxableIncome = Math.max(0, gross - pretax - stdDeduction);
      const fedRes = applyProgressiveTax(taxableIncome, brackets);
      const fedTax = fedRes.totalTax;

      const ficaTax = includeFica ? gross * 0.0765 : 0;
      const stateTax = Math.max(0, gross - pretax) * (stateRate / 100);
      const totalTax = fedTax + ficaTax + stateTax;

      const netIncome = Math.max(0, gross - totalTax);
      const effectiveRate = gross > 0 ? (totalTax / gross) * 100 : 0;

      (document.getElementById('hero-result-value') as HTMLElement).textContent = formatCurrency(totalTax);
      (document.getElementById('res-p1') as HTMLElement).textContent = formatCurrency(fedTax) + '/yr';
      (document.getElementById('res-p2') as HTMLElement).textContent = formatCurrency(ficaTax) + '/yr';
      (document.getElementById('res-p3') as HTMLElement).textContent = formatCurrency(stateTax) + '/yr';
      (document.getElementById('res-p4') as HTMLElement).textContent = formatPercent(effectiveRate, 1);
      (document.getElementById('res-p5') as HTMLElement).textContent = formatCurrency(netIncome) + '/yr';

      const canvas = document.getElementById('calc-chart') as HTMLCanvasElement;
      if (canvas) {
        renderDonutChart(canvas, ['Net Take-Home', 'Federal Income Tax', 'FICA Taxes', 'State Tax'], [netIncome, fedTax, ficaTax, stateTax]);
      }
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
