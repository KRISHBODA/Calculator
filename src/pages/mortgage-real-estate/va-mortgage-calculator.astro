---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="VA Mortgage Calculator"
  description="Calculate VA loan payments with official VA funding fee tier structures, service branch selections, down payment discounts, and total monthly PITI."
  category="Mortgage & Real Estate"
  categoryHref="/#mortgage-real-estate"
  resultLabel="Total Monthly VA Payment"
  resultSuffix="/mo"
>
  <div slot="inputs" class="space-y-4">
    <div class="space-y-1.5 border-b border-[var(--rule-light)] pb-3">
      <label for="price" class="block text-xs font-semibold text-[var(--ink)]">1. Home Purchase Price ($)</label>
      <input type="number" id="price" value="300000" min="20000" step="5000" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs text-[var(--ink)]" />
    </div>

    <div class="grid grid-cols-3 gap-2 border-b border-[var(--rule-light)] pb-3 text-xs">
      <div>
        <label for="down-pct" class="block text-[var(--ink-soft)] mb-1">Down (%)</label>
        <input type="number" id="down-pct" value="0" min="0"  step="1" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="rate" class="block text-[var(--ink-soft)] mb-1">Rate (%)</label>
        <input type="number" id="rate" value="6.0" min="0.1"  step="0.1" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="term" class="block text-[var(--ink-soft)] mb-1">Term (Yrs)</label>
        <select id="term" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-[var(--ink)] font-mono text-xs">
          <option value="30" selected>30 Yrs</option>
          <option value="20">20 Yrs</option>
          <option value="15">15 Yrs</option>
        </select>
      </div>
    </div>

    <div class="space-y-2 border-b border-[var(--rule-light)] pb-3 text-xs">
      <div class="font-semibold text-[var(--ink-soft)] uppercase tracking-wider">2. VA Eligibility Tiers</div>
      <div class="grid grid-cols-2 gap-2">
        <div>
          <label for="service-type" class="block text-[var(--ink-soft)] mb-1">Service Type</label>
          <select id="service-type" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-[var(--ink)] font-mono">
            <option value="regular" selected>Regular Military</option>
            <option value="reserve">Reserves / Guard</option>
          </select>
        </div>
        <div>
          <label for="usage-history" class="block text-[var(--ink-soft)] mb-1">VA Loan Usage</label>
          <select id="usage-history" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-[var(--ink)] font-mono">
            <option value="first" selected>First-Time Use</option>
            <option value="subsequent">Subsequent Use</option>
          </select>
        </div>
      </div>
      <div class="flex items-center space-x-2 pt-1">
        <input type="checkbox" id="disability-exempt" class="accent-[var(--green)] cursor-pointer" />
        <label for="disability-exempt" class="text-xs text-[var(--ink)] cursor-pointer">Exempt from Funding Fee (Service Disability)</label>
      </div>
    </div>

    <div class="space-y-2 text-xs">
      <div class="font-semibold text-[var(--ink-soft)] uppercase tracking-wider">3. Taxes & Insurance</div>
      <div class="grid grid-cols-3 gap-2">
        <div>
          <label for="tax" class="block text-[var(--ink-soft)] mb-1">Tax ($/yr)</label>
          <input type="number" id="tax" value="3600" min="0" step="100" class="w-full p-1 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
        </div>
        <div>
          <label for="ins" class="block text-[var(--ink-soft)] mb-1">Ins ($/yr)</label>
          <input type="number" id="ins" value="1200" min="0" step="50" class="w-full p-1 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
        </div>
        <div>
          <label for="hoa" class="block text-[var(--ink-soft)] mb-1">HOA ($/mo)</label>
          <input type="number" id="hoa" value="0" min="0" step="25" class="w-full p-1 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
        </div>
      </div>
    </div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>VA Funding Fee Rate:</span><span id="res-p1" class="font-bold text-white">2.15%</span></div>
    <div class="flex justify-between"><span>Financed VA Funding Fee:</span><span id="res-p2" class="font-bold text-emerald-200">$0.00</span></div>
    <div class="flex justify-between"><span>Total Financed Loan Balance:</span><span id="res-p3" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between"><span>Principal & Interest (P&I):</span><span id="res-p4" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between pt-1 border-t border-emerald-800/60 font-bold text-white"><span>Monthly Taxes & Insurance:</span><span id="res-p5">$0.00</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Monthly Payment Components" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>VA loans feature $0 down payment requirement and no monthly PMI. Official funding fee tiers apply based on down payment % (0%, 5%, 10%+) and usage history unless exempt.</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>$300,000 home with 0% down and 2.15% VA funding fee ($6,450) financed equals $306,450 total loan ($1,837/mo P&I at 6%).</p>
  </div>
</CalculatorShell>

<script>
  import { amortizedPayment, formatCurrency, formatPercent } from '../../scripts/finance.js';
  import { renderDonutChart } from '../../scripts/charts.js';

  function update() {
    try {
      const price = parseFloat((document.getElementById('price') as HTMLInputElement)?.value || '300000');
      const downPct = parseFloat((document.getElementById('down-pct') as HTMLInputElement)?.value || '0');
      const rate = parseFloat((document.getElementById('rate') as HTMLInputElement)?.value || '6.0');
      const yrs = parseInt((document.getElementById('term') as HTMLSelectElement)?.value || '30');

      const isSubsequent = (document.getElementById('usage-history') as HTMLSelectElement)?.value === 'subsequent';
      const isExempt = (document.getElementById('disability-exempt') as HTMLInputElement)?.checked;

      const tax = parseFloat((document.getElementById('tax') as HTMLInputElement)?.value || '3600');
      const ins = parseFloat((document.getElementById('ins') as HTMLInputElement)?.value || '1200');
      const hoa = parseFloat((document.getElementById('hoa') as HTMLInputElement)?.value || '0');

      const downCash = price * (downPct / 100);
      const baseLoan = Math.max(0, price - downCash);

      let feeRate = 2.15;
      if (isExempt) {
        feeRate = 0;
      } else {
        if (downPct < 5) {
          feeRate = isSubsequent ? 3.3 : 2.15;
        } else if (downPct < 10) {
          feeRate = 1.5;
        } else {
          feeRate = 1.25;
        }
      }

      const fundingFee = baseLoan * (feeRate / 100);
      const totalLoan = baseLoan + fundingFee;

      const pi = amortizedPayment(totalLoan, rate, yrs * 12);
      const monthlyEscrow = (tax / 12) + (ins / 12) + hoa;
      const totalMonthlyPmt = pi + monthlyEscrow;

      (document.getElementById('hero-result-value') as HTMLElement).textContent = formatCurrency(totalMonthlyPmt);
      (document.getElementById('res-p1') as HTMLElement).textContent = formatPercent(feeRate, 2);
      (document.getElementById('res-p2') as HTMLElement).textContent = formatCurrency(fundingFee);
      (document.getElementById('res-p3') as HTMLElement).textContent = formatCurrency(totalLoan);
      (document.getElementById('res-p4') as HTMLElement).textContent = formatCurrency(pi) + '/mo';
      (document.getElementById('res-p5') as HTMLElement).textContent = formatCurrency(monthlyEscrow) + '/mo';

      const canvas = document.getElementById('calc-chart') as HTMLCanvasElement;
      if (canvas) {
        renderDonutChart(canvas, ['Principal & Interest', 'Taxes & Insurance', 'HOA Fees'], [pi, (tax / 12) + (ins / 12), hoa]);
      }
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
