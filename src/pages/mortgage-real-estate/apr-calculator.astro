---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="APR Calculator"
  description="Calculate the true Annual Percentage Rate (APR) incorporating loan interest, origination fees, closing costs, and discount points."
  category="Mortgage & Real Estate"
  categoryHref="/#mortgage-real-estate"
  resultLabel="Effective Annual Percentage Rate (APR)"
  resultSuffix="%"
>
  <div slot="inputs" class="space-y-4">
    <div class="space-y-1.5 border-b border-[var(--rule-light)] pb-3">
      <label for="amount" class="block text-xs font-semibold text-[var(--ink)]">1. Loan Amount ($)</label>
      <input type="number" id="amount" value="200000" min="5000" step="5000" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs text-[var(--ink)]" />
    </div>

    <div class="grid grid-cols-2 gap-3 border-b border-[var(--rule-light)] pb-3 text-xs">
      <div>
        <label for="rate" class="block text-[var(--ink-soft)] mb-1">Stated Rate (%)</label>
        <input type="number" id="rate" value="6.0" min="0.1"  step="0.1" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="years" class="block text-[var(--ink-soft)] mb-1">Loan Term</label>
        <select id="years" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-[var(--ink)] font-mono text-xs">
          <option value="30" selected>30 Years (360 mos)</option>
          <option value="20">20 Years (240 mos)</option>
          <option value="15">15 Years (180 mos)</option>
          <option value="10">10 Years (120 mos)</option>
          <option value="5">5 Years (60 mos)</option>
        </select>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-3 text-xs">
      <div>
        <label for="fees" class="block text-[var(--ink-soft)] mb-1">Closing & Lender Fees ($)</label>
        <input type="number" id="fees" value="3000" min="0" step="250" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="points" class="block text-[var(--ink-soft)] mb-1">Discount Points ($)</label>
        <input type="number" id="points" value="1000" min="0" step="250" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
    </div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>Scheduled Monthly Payment:</span><span id="res-p1" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between"><span>Total Finance Charges & Fees:</span><span id="res-p2" class="font-bold text-emerald-200">$0.00</span></div>
    <div class="flex justify-between"><span>Net Loan Proceeds Delivered:</span><span id="res-p3" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between pt-1 border-t border-emerald-800/60 font-bold text-white"><span>Stated vs APR Difference:</span><span id="res-p4">+0.00%</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Loan Capital Allocation" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>APR is solved numerically by finding the interest rate r where Net Proceeds = sum of discounted monthly payments: Net Proceeds = Loan Amount - Total Upfront Fees.</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>A $200,000 6.0% 30-year loan with $3,000 closing fees + $1,000 points ($4,000 total fees) yields an effective APR of 6.18%.</p>
  </div>
</CalculatorShell>

<script>
  import { amortizedPayment, formatCurrency, formatPercent } from '../../scripts/finance.js';
  import { renderDonutChart } from '../../scripts/charts.js';

  function update() {
    try {
      const amount = parseFloat((document.getElementById('amount') as HTMLInputElement)?.value || '200000');
      const rate = parseFloat((document.getElementById('rate') as HTMLInputElement)?.value || '6.0');
      const yrs = parseInt((document.getElementById('years') as HTMLSelectElement)?.value || '30');
      const fees = parseFloat((document.getElementById('fees') as HTMLInputElement)?.value || '3000');
      const points = parseFloat((document.getElementById('points') as HTMLInputElement)?.value || '1000');

      const totalUpfrontFees = fees + points;
      const netProceeds = Math.max(1, amount - totalUpfrontFees);
      const months = yrs * 12;

      const monthlyPmt = amortizedPayment(amount, rate, months);

      // Solve APR using Newton-Raphson / bisection solver
      let low = 0.0001;
      let high = 0.5;
      let solvedMonthlyRate = (rate / 100) / 12;

      for (let i = 0; i < 40; i++) {
        const mid = (low + high) / 2;
        let pv = 0;
        if (mid > 0) {
          pv = monthlyPmt * (1 - Math.pow(1 + mid, -months)) / mid;
        } else {
          pv = monthlyPmt * months;
        }

        if (pv > netProceeds) {
          low = mid;
        } else {
          high = mid;
        }
      }
      solvedMonthlyRate = (low + high) / 2;
      const aprAnnual = solvedMonthlyRate * 12 * 100;
      const diff = aprAnnual - rate;

      (document.getElementById('hero-result-value') as HTMLElement).textContent = formatPercent(aprAnnual, 2);
      (document.getElementById('res-p1') as HTMLElement).textContent = formatCurrency(monthlyPmt) + '/mo';
      (document.getElementById('res-p2') as HTMLElement).textContent = formatCurrency(totalUpfrontFees);
      (document.getElementById('res-p3') as HTMLElement).textContent = formatCurrency(netProceeds);
      (document.getElementById('res-p4') as HTMLElement).textContent = `+${formatPercent(diff, 2)}`;

      const canvas = document.getElementById('calc-chart') as HTMLCanvasElement;
      if (canvas) {
        renderDonutChart(canvas, ['Net Loan Capital', 'Upfront Fees & Points'], [netProceeds, totalUpfrontFees]);
      }
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
