---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="Down Payment Calculator"
  description="Calculate how much cash you need for a home down payment, project savings accumulation timelines, and compare monthly payments across down payment percentage options."
  category="Mortgage & Real Estate"
  categoryHref="/#mortgage-real-estate"
  resultLabel="Required Down Payment Cash"
  resultSuffix="total"
>
  <div slot="inputs" class="space-y-4">
    <div class="space-y-1.5 border-b border-[var(--rule-light)] pb-3">
      <label for="price" class="block text-xs font-semibold text-[var(--ink)]">1. Target Home Purchase Price ($)</label>
      <input type="number" id="price" value="350000" min="50000" step="10000" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs text-[var(--ink)]" />
    </div>

    <div class="grid grid-cols-2 gap-3 border-b border-[var(--rule-light)] pb-3 text-xs">
      <div>
        <label for="pct" class="block text-[var(--ink-soft)] mb-1">Target Down Payment (%)</label>
        <select id="pct" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-[var(--ink)] font-mono text-xs">
          <option value="3">3% (Conventional Minimum)</option>
          <option value="3.5">3.5% (FHA Minimum)</option>
          <option value="5">5% (Standard Starter)</option>
          <option value="10" selected>10% (Intermediate)</option>
          <option value="20">20% (No PMI Target)</option>
        </select>
      </div>
      <div>
        <label for="rate" class="block text-[var(--ink-soft)] mb-1">Mortgage Rate (%)</label>
        <input type="number" id="rate" value="6.5" min="0.1"  step="0.1" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
    </div>

    <div class="space-y-2 text-xs">
      <div class="font-semibold text-[var(--ink-soft)] uppercase tracking-wider">2. Savings Accumulation Plan</div>
      <div class="grid grid-cols-3 gap-2">
        <div>
          <label for="current-saved" class="block text-[var(--ink-soft)] mb-1">Current Saved ($)</label>
          <input type="number" id="current-saved" value="15000" min="0" step="1000" class="w-full p-1 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
        </div>
        <div>
          <label for="monthly-contrib" class="block text-[var(--ink-soft)] mb-1">Savings/mo ($)</label>
          <input type="number" id="monthly-contrib" value="800" min="0" step="50" class="w-full p-1 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
        </div>
        <div>
          <label for="savings-return" class="block text-[var(--ink-soft)] mb-1">Return (%)</label>
          <input type="number" id="savings-return" value="4.5" min="0"  step="0.25" class="w-full p-1 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
        </div>
      </div>
    </div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>Remaining Savings Needed:</span><span id="res-p1" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between"><span>Timeline to Reach Goal:</span><span id="res-p2" class="font-bold text-emerald-200">0 months</span></div>
    <div class="flex justify-between"><span>Estimated Monthly Mortgage Payment:</span><span id="res-p3" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between pt-1 border-t border-emerald-800/60 font-bold text-white"><span>Monthly PMI Cost:</span><span id="res-p4">$0.00</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Down Payment Cash Progress" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>Target Cash = Home Price × Down Payment %. Savings trajectory applies monthly compound growth until target cash goal is accumulated.</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>On a $350,000 home, a 10% down payment requires $35,000 cash. With $15,000 currently saved and $800/month contributions at 4.5% yield, you reach the goal in ~24 months.</p>
  </div>
</CalculatorShell>

<script>
  import { amortizedPayment, formatCurrency } from '../../scripts/finance.js';
  import { renderDonutChart } from '../../scripts/charts.js';

  function update() {
    try {
      const price = parseFloat((document.getElementById('price') as HTMLInputElement)?.value || '350000');
      const pct = parseFloat((document.getElementById('pct') as HTMLSelectElement)?.value || '10');
      const rate = parseFloat((document.getElementById('rate') as HTMLInputElement)?.value || '6.5');

      const saved = parseFloat((document.getElementById('current-saved') as HTMLInputElement)?.value || '15000');
      const monthly = parseFloat((document.getElementById('monthly-contrib') as HTMLInputElement)?.value || '800');
      const yieldRate = parseFloat((document.getElementById('savings-return') as HTMLInputElement)?.value || '4.5');

      const requiredDownCash = price * (pct / 100);
      const remainingNeeded = Math.max(0, requiredDownCash - saved);

      let monthsToGoal = 0;
      let balance = saved;
      const monthlyReturn = (yieldRate / 100) / 12;

      while (balance < requiredDownCash && monthsToGoal < 360 && monthly > 0) {
        monthsToGoal++;
        balance = (balance + monthly) * (1 + monthlyReturn);
      }

      const loanAmount = price - requiredDownCash;
      const pi = amortizedPayment(loanAmount, rate, 360);
      const pmi = pct < 20 ? (loanAmount * 0.005) / 12 : 0;
      const totalMonthlyMortgage = pi + pmi;

      const yrsToGoal = Math.floor(monthsToGoal / 12);
      const remMosToGoal = monthsToGoal % 12;
      const timelineText = remainingNeeded === 0
        ? 'Goal already met!'
        : (yrsToGoal > 0 ? `${yrsToGoal} yrs ${remMosToGoal} mos (${monthsToGoal} mos)` : `${monthsToGoal} months`);

      (document.getElementById('hero-result-value') as HTMLElement).textContent = formatCurrency(requiredDownCash);
      (document.getElementById('res-p1') as HTMLElement).textContent = formatCurrency(remainingNeeded);
      (document.getElementById('res-p2') as HTMLElement).textContent = timelineText;
      (document.getElementById('res-p3') as HTMLElement).textContent = formatCurrency(totalMonthlyMortgage) + '/mo';
      (document.getElementById('res-p4') as HTMLElement).textContent = pmi > 0 ? formatCurrency(pmi) + '/mo' : '$0.00 (No PMI)';

      const canvas = document.getElementById('calc-chart') as HTMLCanvasElement;
      if (canvas) {
        renderDonutChart(canvas, ['Current Cash Saved', 'Remaining Cash Needed'], [Math.min(saved, requiredDownCash), remainingNeeded]);
      }
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
