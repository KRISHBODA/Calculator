---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="Cash Back or Low Interest Calculator"
  description="Compare cash rebate vs low interest rate auto offers."
  category="Auto Loans & Leases"
  categoryHref="/#auto"
  resultLabel="Better Offer Option"
  resultSuffix=""
>
  <div slot="inputs" class="space-y-4">
    <div class="space-y-1.5"><label class="text-xs font-medium">Vehicle Price ($)</label><input type="number" id="price" value="30000" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs" /></div><div class="space-y-1.5"><label class="text-xs font-medium">Rebate Amount ($)</label><input type="number" id="rebate" value="2500" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs" /></div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>Total Cost with Rebate:</span><span id="res-p1" class="font-bold text-white">$0.00</span></div><div class="flex justify-between"><span>Total Cost with Low Rate:</span><span id="res-p2" class="font-bold text-emerald-200">$0.00</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Breakdown" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>Compares Total Cost (Option A: Rebate Applied, Standard Rate) vs (Option B: No Rebate, Low Rate).</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>$2,500 rebate at 6.5% standard rate saves more than 1.9% financing without rebate on a $30k vehicle.</p>
  </div>
</CalculatorShell>

<script>
  import { amortizedPayment, amortizationSchedule, futureValueLumpSum, futureValueSeries, investmentGrowth, presentValue, solveRate, irr, applyProgressiveTax, formatCurrency, formatPercent, formatNumber } from '../../scripts/finance.js';
  import { TAX_BRACKETS_2024, STANDARD_DEDUCTION_2024, FICA_RATES, IRS_UNIFORM_LIFETIME_TABLE } from '../../scripts/taxData.js';
  import { renderDonutChart, renderLineChart } from '../../scripts/charts.js';

  function update() {
    try {
      const price = parseFloat((document.getElementById('price') as HTMLInputElement)?.value || '30000'); const rebate = parseFloat((document.getElementById('rebate') as HTMLInputElement)?.value || '2500'); const costA = amortizedPayment(price - rebate, 6.5, 60) * 60; const costB = amortizedPayment(price, 1.9, 60) * 60; const rec = costA < costB ? 'Take Cash Rebate' : 'Take Low Rate'; (document.getElementById('hero-result-value') as HTMLElement).textContent = rec; (document.getElementById('res-p1') as HTMLElement).textContent = formatCurrency(costA); (document.getElementById('res-p2') as HTMLElement).textContent = formatCurrency(costB); const canvas = document.getElementById('calc-chart') as HTMLCanvasElement; if (canvas) renderDonutChart(canvas, ['Rebate Option Cost', 'Low Rate Option Cost'], [costA, costB]);
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
