---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="IRR Calculator"
  description="Calculate internal rate of return."
  category="Investment & Savings"
  categoryHref="/#investment"
  resultLabel="Internal Rate of Return"
  resultSuffix="%"
>
  <div slot="inputs" class="space-y-4">
    <div class="space-y-1.5"><label class="text-xs font-medium">Initial Outflow ($)</label><input type="number" id="cf0" value="-10000" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs" /></div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>Outflow:</span><span id="res-p1" class="font-bold text-white">$10,000.00</span></div><div class="flex justify-between"><span>Inflows Sum:</span><span id="res-p2" class="font-bold text-emerald-200">$12,000.00</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Breakdown" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>Newton-Raphson IRR solver.</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>-$10k followed by +$3k, +$4k, +$5k = 8.89% IRR.</p>
  </div>
</CalculatorShell>

<script>
  import { amortizedPayment, amortizationSchedule, futureValueLumpSum, futureValueSeries, investmentGrowth, presentValue, solveRate, irr, applyProgressiveTax, formatCurrency, formatPercent, formatNumber } from '../../scripts/finance.js';
  import { TAX_BRACKETS_2024, STANDARD_DEDUCTION_2024, FICA_RATES, IRS_UNIFORM_LIFETIME_TABLE } from '../../scripts/taxData.js';
  import { renderDonutChart, renderLineChart } from '../../scripts/charts.js';

  function update() {
    try {
      const irrVal = irr([-10000, 3000, 4000, 5000]); (document.getElementById('hero-result-value') as HTMLElement).textContent = formatPercent(irrVal, 2); (document.getElementById('res-p1') as HTMLElement).textContent = '$10,000.00'; (document.getElementById('res-p2') as HTMLElement).textContent = '$12,000.00'; const canvas = document.getElementById('calc-chart') as HTMLCanvasElement; if (canvas) renderDonutChart(canvas, ['Outflow', 'Inflows'], [10000, 12000]);
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
