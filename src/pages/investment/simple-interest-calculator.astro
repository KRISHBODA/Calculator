---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="Simple Interest Calculator"
  description="Calculate non-compounding simple interest earned or paid over a specified time period in years, months, or days."
  category="Investment & Savings"
  categoryHref="/#investment"
  resultLabel="Total End Balance"
  resultSuffix="total"
>
  <div slot="inputs" class="space-y-4">
    <div class="space-y-1.5 border-b border-[var(--rule-light)] pb-3">
      <label for="p-val" class="block text-xs font-semibold text-[var(--ink)]">1. Principal Amount ($)</label>
      <input type="number" id="p-val" value="10000" min="100" step="500" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs text-[var(--ink)]" />
    </div>

    <div class="grid grid-cols-2 gap-3 border-b border-[var(--rule-light)] pb-3 text-xs">
      <div>
        <label for="r-val" class="block text-[var(--ink-soft)] mb-1">Simple Rate (%)</label>
        <input type="number" id="r-val" value="5.0" min="0.1"  step="0.1" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="unit-val" class="block text-[var(--ink-soft)] mb-1">Time Unit</label>
        <select id="unit-val" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-[var(--ink)] font-mono text-xs">
          <option value="years" selected>Years</option>
          <option value="months">Months</option>
          <option value="days">Days</option>
        </select>
      </div>
    </div>

    <div class="space-y-1 text-xs">
      <label for="t-val" class="block text-[var(--ink-soft)] mb-1">Time Duration</label>
      <input type="number" id="t-val" value="3" min="1" step="1" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
    </div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>Principal Amount:</span><span id="res-p1" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between"><span>Simple Interest Earned:</span><span id="res-p2" class="font-bold text-emerald-200">$0.00</span></div>
    <div class="flex justify-between pt-1 border-t border-emerald-800/60 font-bold text-white"><span>Total Payout Balance:</span><span id="res-p3">$0.00</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Principal vs Simple Interest" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>Simple Interest I = P * r * t. Total Balance = P + I. Interest is calculated strictly on original principal without compounding.</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>$10,000 principal at 5% simple interest over 3 years yields $1,500 interest ($11,500 total payout).</p>
  </div>
</CalculatorShell>

<script>
  import { formatCurrency } from '../../scripts/finance.js';
  import { renderDonutChart } from '../../scripts/charts.js';

  function update() {
    try {
      const p = parseFloat((document.getElementById('p-val') as HTMLInputElement)?.value || '10000');
      const r = parseFloat((document.getElementById('r-val') as HTMLInputElement)?.value || '5.0');
      const unit = (document.getElementById('unit-val') as HTMLSelectElement)?.value || 'years';
      const duration = parseFloat((document.getElementById('t-val') as HTMLInputElement)?.value || '3');

      let timeInYears = duration;
      if (unit === 'months') timeInYears = duration / 12;
      else if (unit === 'days') timeInYears = duration / 365;

      const interest = p * (r / 100) * timeInYears;
      const total = p + interest;

      (document.getElementById('hero-result-value') as HTMLElement).textContent = formatCurrency(total);
      (document.getElementById('res-p1') as HTMLElement).textContent = formatCurrency(p);
      (document.getElementById('res-p2') as HTMLElement).textContent = formatCurrency(interest);
      (document.getElementById('res-p3') as HTMLElement).textContent = formatCurrency(total);

      const canvas = document.getElementById('calc-chart') as HTMLCanvasElement;
      if (canvas) {
        renderDonutChart(canvas, ['Principal', 'Simple Interest'], [p, interest]);
      }
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
