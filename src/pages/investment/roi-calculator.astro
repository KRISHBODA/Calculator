---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="ROI Calculator"
  description="Calculate total Return on Investment (ROI %), net financial profit, and annualized compound ROI (CAGR)."
  category="Investment & Savings"
  categoryHref="/#investment"
  resultLabel="Total Return on Investment (ROI)"
  resultSuffix="%"
>
  <div slot="inputs" class="space-y-4">
    <div class="space-y-1.5 border-b border-[var(--rule-light)] pb-3">
      <label for="inv-val" class="block text-xs font-semibold text-[var(--ink)]">1. Amount Invested ($)</label>
      <input type="number" id="inv-val" value="10000" min="100" step="500" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs text-[var(--ink)]" />
    </div>

    <div class="grid grid-cols-2 gap-3 text-xs">
      <div>
        <label for="ret-val" class="block text-[var(--ink-soft)] mb-1">Ending Value ($)</label>
        <input type="number" id="ret-val" value="16000" min="0" step="500" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="yrs-val" class="block text-[var(--ink-soft)] mb-1">Horizon (Years)</label>
        <input type="number" id="yrs-val" value="5" min="0.1"  step="0.5" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
    </div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>Net Capital Profit:</span><span id="res-p1" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between"><span>Annualized ROI (CAGR):</span><span id="res-p2" class="font-bold text-emerald-200">0.0%</span></div>
    <div class="flex justify-between pt-1 border-t border-emerald-800/60 font-bold text-white"><span>Growth Multiple:</span><span id="res-p3">0.0x</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Initial Capital vs Net Gain" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>Total ROI = ((Ending Value − Initial Investment) / Initial Investment) × 100. Annualized ROI = (Ending Value / Initial Investment)^(1/t) − 1.</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>Investing $10,000 returned $16,000 after 5 years equals a 60.0% total ROI ($6,000 profit) and a 9.86% annualized CAGR.</p>
  </div>
</CalculatorShell>

<script>
  import { formatCurrency, formatPercent } from '../../scripts/finance.js';
  import { renderDonutChart } from '../../scripts/charts.js';

  function update() {
    try {
      const inv = parseFloat((document.getElementById('inv-val') as HTMLInputElement)?.value || '10000');
      const ret = parseFloat((document.getElementById('ret-val') as HTMLInputElement)?.value || '16000');
      const yrs = parseFloat((document.getElementById('yrs-val') as HTMLInputElement)?.value || '5');

      const netProfit = ret - inv;
      const totalRoi = inv > 0 ? (netProfit / inv) * 100 : 0;
      const annualizedRoi = (inv > 0 && ret > 0 && yrs > 0) ? (Math.pow(ret / inv, 1 / yrs) - 1) * 100 : 0;
      const multiple = inv > 0 ? ret / inv : 0;

      (document.getElementById('hero-result-value') as HTMLElement).textContent = formatPercent(totalRoi, 2);
      (document.getElementById('res-p1') as HTMLElement).textContent = formatCurrency(netProfit);
      (document.getElementById('res-p2') as HTMLElement).textContent = formatPercent(annualizedRoi, 2);
      (document.getElementById('res-p3') as HTMLElement).textContent = `${multiple.toFixed(2)}x`;

      const canvas = document.getElementById('calc-chart') as HTMLCanvasElement;
      if (canvas) {
        renderDonutChart(canvas, ['Initial Invested Capital', 'Net Capital Profit'], [inv, Math.max(0, netProfit)]);
      }
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
