---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="Compound Interest Calculator"
  description="Calculate how compounding interest frequency accelerates asset growth over time with optional regular deposits."
  category="Investment & Savings"
  categoryHref="/#investment"
  resultLabel="End Compound Balance"
  resultSuffix="total"
>
  <div slot="inputs" class="space-y-4">
    <div class="space-y-1.5 border-b border-[var(--rule-light)] pb-3">
      <div class="flex justify-between items-center text-xs font-medium">
        <label for="initial-num" class="text-[var(--ink)]">Initial Balance ($)</label>
        <span class="font-mono text-[var(--ink-soft)]">$<input type="number" id="initial-num" value="5000" min="0"  step="500" class="w-28 text-right bg-transparent border-b border-[var(--rule)] focus:border-[var(--green)] focus:outline-none font-mono" /></span>
      </div>
      
    </div>

    <div class="grid grid-cols-2 gap-3 border-b border-[var(--rule-light)] pb-3 text-xs">
      <div>
        <label for="rate-num" class="block text-[var(--ink-soft)] mb-1">Interest Rate (%)</label>
        <input type="number" id="rate-num" value="5.0" min="0.1"  step="0.1" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="years-num" class="block text-[var(--ink-soft)] mb-1">Years to Grow</label>
        <input type="number" id="years-num" value="5" min="1"  step="1" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
    </div>

    <div class="grid grid-cols-2 gap-3 text-xs">
      <div>
        <label for="contrib-num" class="block text-[var(--ink-soft)] mb-1">Monthly Deposit ($)</label>
        <input type="number" id="contrib-num" value="100" min="0" step="25" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="compound-select" class="block text-[var(--ink-soft)] mb-1">Compounding Frequency</label>
        <select id="compound-select" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-[var(--ink)] font-mono text-xs">
          <option value="12" selected>Monthly (12/yr)</option>
          <option value="365">Daily (365/yr)</option>
          <option value="4">Quarterly (4/yr)</option>
          <option value="1">Annually (1/yr)</option>
        </select>
      </div>
    </div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>Initial Principal:</span><span id="res-p1" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between"><span>Total Contributions:</span><span id="res-p2" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between"><span>Total Compound Interest:</span><span id="res-p3" class="font-bold text-emerald-200">$0.00</span></div>
    <div class="flex justify-between pt-1 border-t border-emerald-800/60 font-bold text-white"><span>Effective APY Yield:</span><span id="res-p4">0.0%</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Compounded Balance Breakdown" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>Compound Interest A = P*(1 + r/n)^(n*t). Effective APY = (1 + r/n)^n - 1. Compounding interest yields returns on prior accrued interest.</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>$5,000 initial balance + $100/mo at 5.0% interest compounded monthly over 5 years yields $13,201 ($11,000 capital + $2,201 compound interest).</p>
  </div>
</CalculatorShell>

<script>
  import { formatCurrency, formatPercent } from '../../scripts/finance.js';
  import { renderDonutChart } from '../../scripts/charts.js';

  function update() {
    try {
      const p = parseFloat((document.getElementById('initial-num') as HTMLInputElement)?.value || '5000');
      const rate = parseFloat((document.getElementById('rate-num') as HTMLInputElement)?.value || '5.0');
      const yrs = parseInt((document.getElementById('years-num') as HTMLInputElement)?.value || '5');

      const contrib = parseFloat((document.getElementById('contrib-num') as HTMLInputElement)?.value || '100');
      const compoundN = parseInt((document.getElementById('compound-select') as HTMLSelectElement)?.value || '12');

      

      const rDecimal = rate / 100;
      const totalContribs = contrib * 12 * yrs;

      let balance = p;
      const ratePerPeriod = rDecimal / compoundN;
      const totalPeriods = yrs * compoundN;
      const contribPerPeriod = (contrib * 12) / compoundN;

      for (let i = 0; i < totalPeriods; i++) {
        balance = (balance + contribPerPeriod) * (1 + ratePerPeriod);
      }

      const totalInterest = Math.max(0, balance - p - totalContribs);
      const apy = (Math.pow(1 + rDecimal / compoundN, compoundN) - 1) * 100;

      (document.getElementById('hero-result-value') as HTMLElement).textContent = formatCurrency(balance);
      (document.getElementById('res-p1') as HTMLElement).textContent = formatCurrency(p);
      (document.getElementById('res-p2') as HTMLElement).textContent = formatCurrency(totalContribs);
      (document.getElementById('res-p3') as HTMLElement).textContent = formatCurrency(totalInterest);
      (document.getElementById('res-p4') as HTMLElement).textContent = formatPercent(apy, 2);

      const canvas = document.getElementById('calc-chart') as HTMLCanvasElement;
      if (canvas) {
        renderDonutChart(canvas, ['Initial Balance', 'Total Contributions', 'Compound Interest'], [p, totalContribs, totalInterest]);
      }
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
