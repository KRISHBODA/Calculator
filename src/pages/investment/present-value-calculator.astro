---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="Present Value Calculator"
  description="Calculate the present value (PV) required today to achieve a specific target future value given a discount rate and time horizon."
  category="Investment & Savings"
  categoryHref="/#investment"
  resultLabel="Required Present Value (PV)"
  resultSuffix="today"
>
  <div slot="inputs" class="space-y-4">
    <div class="space-y-1.5 border-b border-[var(--rule-light)] pb-3">
      <label for="fv-val" class="block text-xs font-semibold text-[var(--ink)]">1. Target Future Value ($)</label>
      <input type="number" id="fv-val" value="50000" min="1000" step="2500" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs text-[var(--ink)]" />
    </div>

    <div class="grid grid-cols-2 gap-3 border-b border-[var(--rule-light)] pb-3 text-xs">
      <div>
        <label for="rate-val" class="block text-[var(--ink-soft)] mb-1">Discount Rate (%)</label>
        <input type="number" id="rate-val" value="6.0" min="0.1"  step="0.1" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="yrs-val" class="block text-[var(--ink-soft)] mb-1">Time Horizon (Years)</label>
        <input type="number" id="yrs-val" value="10" min="1"  step="1" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
    </div>

    <div class="space-y-1 text-xs">
      <label for="compound-val" class="block text-[var(--ink-soft)] mb-1">Compounding Frequency</label>
      <select id="compound-val" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-[var(--ink)] font-mono text-xs">
        <option value="12" selected>Monthly (12/yr)</option>
        <option value="1">Annually (1/yr)</option>
        <option value="4">Quarterly (4/yr)</option>
        <option value="365">Daily (365/yr)</option>
      </select>
    </div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>Target Future Value (FV):</span><span id="res-p1" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between"><span>Required Lump Sum Today (PV):</span><span id="res-p2" class="font-bold text-emerald-200">$0.00</span></div>
    <div class="flex justify-between pt-1 border-t border-emerald-800/60 font-bold text-white"><span>Discounted Growth Component:</span><span id="res-p3">$0.00</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Present Value vs Compound Growth" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>Present Value PV = FV / (1 + r/n)^(n*t). Discounting computes the current value of a future lump sum cash flow.</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>To reach $50,000 in 10 years at a 6.0% discount rate compounded monthly, you need to deposit $27,482 today.</p>
  </div>
</CalculatorShell>

<script>
  import { formatCurrency } from '../../scripts/finance.js';
  import { renderDonutChart } from '../../scripts/charts.js';

  function update() {
    try {
      const fv = parseFloat((document.getElementById('fv-val') as HTMLInputElement)?.value || '50000');
      const rate = parseFloat((document.getElementById('rate-val') as HTMLInputElement)?.value || '6.0');
      const yrs = parseInt((document.getElementById('yrs-val') as HTMLInputElement)?.value || '10');
      const compoundN = parseInt((document.getElementById('compound-val') as HTMLSelectElement)?.value || '12');

      const rDecimal = rate / 100;
      const ratePerSub = rDecimal / compoundN;
      const totalPeriods = yrs * compoundN;

      const pv = fv / Math.pow(1 + ratePerSub, totalPeriods);
      const discountDiscountedGrowth = Math.max(0, fv - pv);

      (document.getElementById('hero-result-value') as HTMLElement).textContent = formatCurrency(pv);
      (document.getElementById('res-p1') as HTMLElement).textContent = formatCurrency(fv);
      (document.getElementById('res-p2') as HTMLElement).textContent = formatCurrency(pv);
      (document.getElementById('res-p3') as HTMLElement).textContent = formatCurrency(discountDiscountedGrowth);

      const canvas = document.getElementById('calc-chart') as HTMLCanvasElement;
      if (canvas) {
        renderDonutChart(canvas, ['Required Present Value (PV)', 'Compound Growth Component'], [pv, discountDiscountedGrowth]);
      }
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
