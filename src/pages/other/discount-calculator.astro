---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="Discount Calculator"
  description="Calculate final sale price, total savings, stacked coupon discounts, and checkout price including sales tax."
  category="Other Financial Calculators"
  categoryHref="/#other"
  resultLabel="Final Checkout Sale Price"
  resultSuffix="final price"
>
  <div slot="inputs" class="space-y-4">
    <div class="space-y-1.5 border-b border-[var(--rule-light)] pb-3">
      <label for="price-val" class="block text-xs font-semibold text-[var(--ink)]">1. Original Retail Price ($)</label>
      <input type="number" id="price-val" value="120" min="1" step="5" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs text-[var(--ink)]" />
    </div>

    <div class="grid grid-cols-3 gap-2 text-xs">
      <div>
        <label for="disc-pct" class="block text-[var(--ink-soft)] mb-1">Discount (%)</label>
        <input type="number" id="disc-pct" value="25" min="0" max="99" step="1" class="w-full p-1 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="stack-pct" class="block text-[var(--ink-soft)] mb-1">Stacked Coupon (%)</label>
        <input type="number" id="stack-pct" value="10" min="0" max="50" step="1" class="w-full p-1 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="tax-rate" class="block text-[var(--ink-soft)] mb-1">Sales Tax (%)</label>
        <input type="number" id="tax-rate" value="8.0" min="0" max="25" step="0.5" class="w-full p-1 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
    </div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>Original Price:</span><span id="res-p1" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between"><span>Total Savings Delivered:</span><span id="res-p2" class="font-bold text-emerald-200">-$0.00</span></div>
    <div class="flex justify-between"><span>Discounted Pre-Tax Price:</span><span id="res-p3" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between pt-1 border-t border-emerald-800/60 font-bold text-white"><span>Sales Tax Amount:</span><span id="res-p4">$0.00</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Original Price vs Discount & Tax" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>Discounted Price = Original × (1 - Discount1%) × (1 - Discount2%). Total Checkout = Discounted Price × (1 + Sales Tax%).</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>$120 item with 25% sale + stacked 10% coupon drops to $81.00 ($39 savings). With 8% sales tax, final checkout price is $87.48.</p>
  </div>
</CalculatorShell>

<script>
  import { formatCurrency } from '../../scripts/finance.js';
  import { renderDonutChart } from '../../scripts/charts.js';

  function update() {
    try {
      const origPrice = parseFloat((document.getElementById('price-val') as HTMLInputElement)?.value || '120');
      const d1 = parseFloat((document.getElementById('disc-pct') as HTMLInputElement)?.value || '25') / 100;
      const d2 = parseFloat((document.getElementById('stack-pct') as HTMLInputElement)?.value || '10') / 100;
      const taxRate = parseFloat((document.getElementById('tax-rate') as HTMLInputElement)?.value || '8.0') / 100;

      const priceAfterD1 = origPrice * (1 - d1);
      const preTaxPrice = priceAfterD1 * (1 - d2);

      const totalSavings = Math.max(0, origPrice - preTaxPrice);
      const taxAmount = preTaxPrice * taxRate;
      const finalCheckoutPrice = preTaxPrice + taxAmount;

      (document.getElementById('hero-result-value') as HTMLElement).textContent = formatCurrency(finalCheckoutPrice);
      (document.getElementById('res-p1') as HTMLElement).textContent = formatCurrency(origPrice);
      (document.getElementById('res-p2') as HTMLElement).textContent = `-${formatCurrency(totalSavings)}`;
      (document.getElementById('res-p3') as HTMLElement).textContent = formatCurrency(preTaxPrice);
      (document.getElementById('res-p4') as HTMLElement).textContent = formatCurrency(taxAmount);

      const canvas = document.getElementById('calc-chart') as HTMLCanvasElement;
      if (canvas) {
        renderDonutChart(canvas, ['Pre-Tax Final Price', 'Total Discount Savings', 'Sales Tax'], [preTaxPrice, totalSavings, taxAmount]);
      }
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
