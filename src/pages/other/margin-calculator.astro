---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="Margin & Markup Calculator"
  description="Calculate gross profit margin percentage, markup percentage, and selling price from cost of goods sold (COGS)."
  category="Other Financial Calculators"
  categoryHref="/#other"
  resultLabel="Gross Profit Margin"
  resultSuffix="margin"
>
  <div slot="inputs" class="space-y-4">
    <div class="space-y-1.5 border-b border-[var(--rule-light)] pb-3">
      <label for="cost-val" class="block text-xs font-semibold text-[var(--ink)]">1. Cost of Goods Sold / COGS ($)</label>
      <input type="number" id="cost-val" value="60" min="0.01" step="5" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs text-[var(--ink)]" />
    </div>

    <div class="grid grid-cols-2 gap-3 text-xs">
      <div>
        <label for="revenue-val" class="block text-[var(--ink-soft)] mb-1">Selling Price ($)</label>
        <input type="number" id="revenue-val" value="100" min="0.01" step="5" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="margin-target" class="block text-[var(--ink-soft)] mb-1">Target Margin (%)</label>
        <input type="number" id="margin-target" value="40.0" min="0.1" max="99.9" step="0.5" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
    </div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>Gross Profit Amount:</span><span id="res-p1" class="font-bold text-emerald-200">$0.00</span></div>
    <div class="flex justify-between"><span>Gross Profit Margin (%):</span><span id="res-p2" class="font-bold text-white">0.0%</span></div>
    <div class="flex justify-between"><span>Markup Percentage (%):</span><span id="res-p3" class="font-bold text-white">0.0%</span></div>
    <div class="flex justify-between pt-1 border-t border-emerald-800/60 font-bold text-white"><span>Required Price for Target Margin:</span><span id="res-p4">$0.00</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Selling Price COGS vs Profit" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>Margin % = (Price - Cost) / Price × 100. Markup % = (Price - Cost) / Cost × 100.</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>$60 COGS sold at $100 price yields $40 gross profit (40.0% gross margin and 66.7% markup on cost).</p>
  </div>
</CalculatorShell>

<script>
  import { formatCurrency, formatPercent } from '../../scripts/finance.js';
  import { renderDonutChart } from '../../scripts/charts.js';

  function update() {
    try {
      const cost = parseFloat((document.getElementById('cost-val') as HTMLInputElement)?.value || '60');
      const price = parseFloat((document.getElementById('revenue-val') as HTMLInputElement)?.value || '100');
      const targetMargin = parseFloat((document.getElementById('margin-target') as HTMLInputElement)?.value || '40.0');

      const profit = price - cost;
      const marginPct = price > 0 ? (profit / price) * 100 : 0;
      const markupPct = cost > 0 ? (profit / cost) * 100 : 0;

      const requiredPriceForTarget = cost / (1 - targetMargin / 100);

      (document.getElementById('hero-result-value') as HTMLElement).textContent = formatPercent(marginPct, 1);
      (document.getElementById('res-p1') as HTMLElement).textContent = formatCurrency(profit);
      (document.getElementById('res-p2') as HTMLElement).textContent = formatPercent(marginPct, 1);
      (document.getElementById('res-p3') as HTMLElement).textContent = formatPercent(markupPct, 1);
      (document.getElementById('res-p4') as HTMLElement).textContent = formatCurrency(requiredPriceForTarget);

      const canvas = document.getElementById('calc-chart') as HTMLCanvasElement;
      if (canvas) {
        renderDonutChart(canvas, ['Cost of Goods Sold (COGS)', 'Gross Profit Margin'], [cost, Math.max(0, profit)]);
      }
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
