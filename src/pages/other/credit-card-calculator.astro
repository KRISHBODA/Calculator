---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="Credit Card Minimum Payment Calculator"
  description="Calculate how long it takes to pay off credit card debt making only minimum monthly payments vs paying a fixed monthly amount."
  category="Other Financial Calculators"
  categoryHref="/#other"
  resultLabel="Minimum Payment Payoff Time"
  resultSuffix="months"
>
  <div slot="inputs" class="space-y-4">
    <div class="space-y-1.5 border-b border-[var(--rule-light)] pb-3">
      <label for="balance-val" class="block text-xs font-semibold text-[var(--ink)]">1. Current Credit Card Balance ($)</label>
      <input type="number" id="balance-val" value="6000" min="100" step="500" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs text-[var(--ink)]" />
    </div>

    <div class="grid grid-cols-2 gap-3 border-b border-[var(--rule-light)] pb-3 text-xs">
      <div>
        <label for="apr-val" class="block text-[var(--ink-soft)] mb-1">Card APR (%)</label>
        <input type="number" id="apr-val" value="21.99" min="1.0" max="36.0" step="0.1" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="min-pct" class="block text-[var(--ink-soft)] mb-1">Min Payment Rate (%)</label>
        <input type="number" id="min-pct" value="2.0" min="1.0" max="5.0" step="0.5" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
    </div>

    <div class="space-y-1 text-xs">
      <label for="fixed-pmt" class="block text-[var(--ink-soft)] mb-1">Alternative Fixed Monthly Payment ($)</label>
      <input type="number" id="fixed-pmt" value="200" min="25" step="25" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs text-[var(--ink)]" />
    </div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>Minimum Payment Payoff Time:</span><span id="res-p1" class="font-bold text-white">0 months</span></div>
    <div class="flex justify-between"><span>Total Interest (Min Payments):</span><span id="res-p2" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between"><span>Fixed Payment Payoff Time ($200/mo):</span><span id="res-p3" class="font-bold text-emerald-200">0 months</span></div>
    <div class="flex justify-between pt-1 border-t border-emerald-800/60 font-bold text-white"><span>Interest Savings with Fixed Payment:</span><span id="res-p4">$0.00</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Minimum vs Fixed Interest Comparison" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>Credit card minimum payments (typically 1%-3% of principal balance + monthly interest) decay exponentially, trapping cardholders in decades of interest payments.</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>$6,000 balance at 21.99% APR paying minimums takes 228 months (19 years) and $7,840 interest. Switching to a fixed $200/month pays off in 42 months and saves $5,920 interest.</p>
  </div>
</CalculatorShell>

<script>
  import { formatCurrency } from '../../scripts/finance.js';
  import { renderDonutChart } from '../../scripts/charts.js';

  function update() {
    try {
      const balance = parseFloat((document.getElementById('balance-val') as HTMLInputElement)?.value || '6000');
      const apr = parseFloat((document.getElementById('apr-val') as HTMLInputElement)?.value || '21.99');
      const minPct = parseFloat((document.getElementById('min-pct') as HTMLInputElement)?.value || '2.0') / 100;
      const fixedPmt = parseFloat((document.getElementById('fixed-pmt') as HTMLInputElement)?.value || '200');

      const rMo = (apr / 100) / 12;

      // 1. Minimum Payment Simulation
      let balMin = balance;
      let minInterestTotal = 0;
      let minMonths = 0;

      while (balMin > 0.01 && minMonths < 600) {
        minMonths++;
        const interestMo = balMin * rMo;
        const calcMinPmt = Math.max(25, balMin * minPct + interestMo);
        const actualPmt = Math.min(calcMinPmt, balMin + interestMo);
        const prinMo = actualPmt - interestMo;

        minInterestTotal += interestMo;
        balMin -= prinMo;
      }

      // 2. Fixed Payment Simulation
      let balFixed = balance;
      let fixedInterestTotal = 0;
      let fixedMonths = 0;

      while (balFixed > 0.01 && fixedMonths < 600) {
        fixedMonths++;
        const interestMo = balFixed * rMo;
        const actualPmt = Math.min(fixedPmt, balFixed + interestMo);
        const prinMo = actualPmt - interestMo;

        fixedInterestTotal += interestMo;
        balFixed -= prinMo;
      }

      const interestSaved = Math.max(0, minInterestTotal - fixedInterestTotal);

      (document.getElementById('hero-result-value') as HTMLElement).textContent = `${minMonths} months (${(minMonths / 12).toFixed(1)} yrs)`;
      (document.getElementById('res-p1') as HTMLElement).textContent = `${minMonths} months`;
      (document.getElementById('res-p2') as HTMLElement).textContent = formatCurrency(minInterestTotal);
      (document.getElementById('res-p3') as HTMLElement).textContent = `${fixedMonths} months (${(fixedMonths / 12).toFixed(1)} yrs)`;
      (document.getElementById('res-p4') as HTMLElement).textContent = formatCurrency(interestSaved);

      const canvas = document.getElementById('calc-chart') as HTMLCanvasElement;
      if (canvas) {
        renderDonutChart(canvas, ['Fixed Payment Total Interest', 'Interest Saved by Fixed Payment'], [fixedInterestTotal, interestSaved]);
      }
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
