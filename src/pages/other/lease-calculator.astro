---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="Lease Calculator"
  description="Calculate equipment or asset lease payments and compare the financial total cost of leasing vs buying outright."
  category="Other Financial Calculators"
  categoryHref="/#other"
  resultLabel="Monthly Lease Payment"
  resultSuffix="/mo"
>
  <div slot="inputs" class="space-y-4">
    <div class="space-y-1.5 border-b border-[var(--rule-light)] pb-3">
      <label for="price-val" class="block text-xs font-semibold text-[var(--ink)]">1. Asset Purchase Price ($)</label>
      <input type="number" id="price-val" value="30000" min="1000" step="2500" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs text-[var(--ink)]" />
    </div>

    <div class="grid grid-cols-2 gap-3 border-b border-[var(--rule-light)] pb-3 text-xs">
      <div>
        <label for="term-yrs" class="block text-[var(--ink-soft)] mb-1">Lease Term (Years)</label>
        <input type="number" id="term-yrs" value="3" min="1"  step="1" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="money-factor" class="block text-[var(--ink-soft)] mb-1">Lease Rate / Money Factor (%)</label>
        <input type="number" id="money-factor" value="6.0" min="0.1"  step="0.1" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
    </div>

    <div class="grid grid-cols-2 gap-3 text-xs">
      <div>
        <label for="residual-val" class="block text-[var(--ink-soft)] mb-1">Residual Value ($)</label>
        <input type="number" id="residual-val" value="16000" min="0" step="1000" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="tax-rate" class="block text-[var(--ink-soft)] mb-1">Sales Tax (%)</label>
        <input type="number" id="tax-rate" value="7.0" min="0"  step="0.5" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
    </div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>Depreciation Fee Component:</span><span id="res-p1" class="font-bold text-white">$0.00/mo</span></div>
    <div class="flex justify-between"><span>Finance Rent Charge:</span><span id="res-p2" class="font-bold text-white">$0.00/mo</span></div>
    <div class="flex justify-between"><span>Monthly Sales Tax:</span><span id="res-p3" class="font-bold text-white">$0.00/mo</span></div>
    <div class="flex justify-between pt-1 border-t border-emerald-800/60 font-bold text-white"><span>Total Net Lease Outflow (Full Term):</span><span id="res-p4" class="text-emerald-200">$0.00</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Lease Payment Structure" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>Depreciation Fee = (Price - Residual) / Term. Rent Charge = (Price + Residual) × Money Factor.</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>$30,000 asset with $16,000 residual value over 3 years at 6.0% rate requires $447.22/month total lease payment ($16,100 total term outflow).</p>
  </div>
</CalculatorShell>

<script>
  import { formatCurrency } from '../../scripts/finance.js';
  import { renderDonutChart } from '../../scripts/charts.js';

  function update() {
    try {
      const price = parseFloat((document.getElementById('price-val') as HTMLInputElement)?.value || '30000');
      const termYrs = parseInt((document.getElementById('term-yrs') as HTMLInputElement)?.value || '3');
      const ratePct = parseFloat((document.getElementById('money-factor') as HTMLInputElement)?.value || '6.0');
      const residual = parseFloat((document.getElementById('residual-val') as HTMLInputElement)?.value || '16000');
      const taxRate = parseFloat((document.getElementById('tax-rate') as HTMLInputElement)?.value || '7.0') / 100;

      const months = termYrs * 12;
      const moneyFactor = (ratePct / 100) / 24;

      const monthlyDeprec = (price - residual) / months;
      const monthlyFinance = (price + residual) * moneyFactor;
      const subtotalPmt = monthlyDeprec + monthlyFinance;
      const monthlyTax = subtotalPmt * taxRate;

      const totalMonthlyLease = subtotalPmt + monthlyTax;
      const totalTermOutflow = totalMonthlyLease * months;

      (document.getElementById('hero-result-value') as HTMLElement).textContent = formatCurrency(totalMonthlyLease);
      (document.getElementById('res-p1') as HTMLElement).textContent = formatCurrency(monthlyDeprec) + '/mo';
      (document.getElementById('res-p2') as HTMLElement).textContent = formatCurrency(monthlyFinance) + '/mo';
      (document.getElementById('res-p3') as HTMLElement).textContent = formatCurrency(monthlyTax) + '/mo';
      (document.getElementById('res-p4') as HTMLElement).textContent = formatCurrency(totalTermOutflow);

      const canvas = document.getElementById('calc-chart') as HTMLCanvasElement;
      if (canvas) {
        renderDonutChart(canvas, ['Asset Depreciation Fee', 'Finance Rent Charge', 'Sales Tax'], [monthlyDeprec * months, monthlyFinance * months, monthlyTax * months]);
      }
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
