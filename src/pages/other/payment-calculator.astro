---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="Payment Calculator"
  description="Calculate your required monthly loan payment or solve for the exact duration needed to pay off a loan given a fixed monthly budget."
  category="Other Financial Calculators"
  categoryHref="/#other"
  resultLabel="Required Monthly Payment"
  resultSuffix="/mo"
>
  <div slot="inputs" class="space-y-4">
    <div class="space-y-1.5 border-b border-[var(--rule-light)] pb-3 text-xs">
      <label for="solve-mode" class="block font-semibold text-[var(--ink)]">Solve Goal</label>
      <select id="solve-mode" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs text-[var(--ink)]">
        <option value="pmt" selected>Calculate Monthly Payment (Fixed Term)</option>
        <option value="term">Calculate Payoff Term (Fixed Monthly Payment)</option>
      </select>
    </div>

    <div class="space-y-1.5 border-b border-[var(--rule-light)] pb-3">
      <label for="principal-val" class="block text-xs font-semibold text-[var(--ink)]">1. Loan Principal Balance ($)</label>
      <input type="number" id="principal-val" value="15000" min="500" step="500" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs text-[var(--ink)]" />
    </div>

    <div class="grid grid-cols-2 gap-3 text-xs">
      <div>
        <label for="rate-val" class="block text-[var(--ink-soft)] mb-1">Interest Rate (%)</label>
        <input type="number" id="rate-val" value="6.8" min="0.1"  step="0.1" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
      <div id="term-container">
        <label for="term-months" class="block text-[var(--ink-soft)] mb-1">Term (Months)</label>
        <input type="number" id="term-months" value="48" min="1"  step="1" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
      <div id="pmt-container" class="hidden">
        <label for="budget-pmt" class="block text-[var(--ink-soft)] mb-1">Fixed Monthly Payment ($)</label>
        <input type="number" id="budget-pmt" value="400" min="10" step="25" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
    </div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>Monthly Payment Amount:</span><span id="res-p1" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between"><span>Total Loan Duration:</span><span id="res-p2" class="font-bold text-white">0 months</span></div>
    <div class="flex justify-between"><span>Total Cumulative Interest:</span><span id="res-p3" class="font-bold text-emerald-200">$0.00</span></div>
    <div class="flex justify-between pt-1 border-t border-emerald-800/60 font-bold text-white"><span>Total Outflow Cost:</span><span id="res-p4">$0.00</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Payment Principal vs Interest" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>Fixed payment amortization formula solve for PMT = P * r / (1 - (1+r)^(-n)) or solve term n = -ln(1 - P*r/PMT) / ln(1+r).</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>$15,000 principal at 6.8% over 48 months requires $357.78/month ($2,173 total interest).</p>
  </div>
</CalculatorShell>

<script>
  import { amortizedPayment, formatCurrency } from '../../scripts/finance.js';
  import { renderDonutChart } from '../../scripts/charts.js';

  function update() {
    try {
      const mode = (document.getElementById('solve-mode') as HTMLSelectElement)?.value || 'pmt';
      const p = parseFloat((document.getElementById('principal-val') as HTMLInputElement)?.value || '15000');
      const rate = parseFloat((document.getElementById('rate-val') as HTMLInputElement)?.value || '6.8');
      const termMonths = parseInt((document.getElementById('term-months') as HTMLInputElement)?.value || '48');
      const budgetPmt = parseFloat((document.getElementById('budget-pmt') as HTMLInputElement)?.value || '400');

      const termContainer = document.getElementById('term-container');
      const pmtContainer = document.getElementById('pmt-container');

      if (mode === 'term') {
        termContainer?.classList.add('hidden');
        pmtContainer?.classList.remove('hidden');
      } else {
        termContainer?.classList.remove('hidden');
        pmtContainer?.classList.add('hidden');
      }

      let monthlyPmt = 0;
      let totalMonths = termMonths;
      let totalInterest = 0;

      const rMo = (rate / 100) / 12;

      if (mode === 'pmt') {
        monthlyPmt = amortizedPayment(p, rate, termMonths);
        totalInterest = (monthlyPmt * termMonths) - p;
      } else {
        monthlyPmt = budgetPmt;
        const minInterestMo = p * rMo;
        if (budgetPmt <= minInterestMo) {
          (document.getElementById('hero-result-value') as HTMLElement).textContent = 'Payment too low';
          return;
        }
        totalMonths = Math.ceil(-Math.log(1 - (p * rMo) / budgetPmt) / Math.log(1 + rMo));
        totalInterest = (budgetPmt * totalMonths) - p;
      }

      (document.getElementById('hero-result-value') as HTMLElement).textContent = mode === 'pmt' ? formatCurrency(monthlyPmt) : `${totalMonths} months`;
      (document.getElementById('res-p1') as HTMLElement).textContent = formatCurrency(monthlyPmt) + '/mo';
      (document.getElementById('res-p2') as HTMLElement).textContent = `${totalMonths} months (${(totalMonths / 12).toFixed(1)} yrs)`;
      (document.getElementById('res-p3') as HTMLElement).textContent = formatCurrency(totalInterest);
      (document.getElementById('res-p4') as HTMLElement).textContent = formatCurrency(p + totalInterest);

      const canvas = document.getElementById('calc-chart') as HTMLCanvasElement;
      if (canvas) {
        renderDonutChart(canvas, ['Principal Loan', 'Total Interest'], [p, totalInterest]);
      }
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
