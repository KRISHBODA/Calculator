---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="Depreciation Calculator"
  description="Calculate asset depreciation schedules, annual tax expense, and ending book value across Straight-Line, Declining Balance, and Sum-of-the-Years'-Digits methods."
  category="Other Financial Calculators"
  categoryHref="/#other"
  resultLabel="Year 1 Depreciation Expense"
  resultSuffix="/yr"
>
  <div slot="inputs" class="space-y-4">
    <div class="space-y-1.5 border-b border-[var(--rule-light)] pb-3 text-xs">
      <label for="method-select" class="block font-semibold text-[var(--ink)]">Depreciation Method</label>
      <select id="method-select" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs text-[var(--ink)]">
        <option value="straight" selected>Straight-Line Method (Equal Annual Expense)</option>
        <option value="db200">200% Double Declining Balance (Accelerated)</option>
        <option value="db150">150% Declining Balance</option>
        <option value="syd">Sum-of-the-Years'-Digits (SYD)</option>
      </select>
    </div>

    <div class="space-y-1.5 border-b border-[var(--rule-light)] pb-3">
      <label for="cost-val" class="block text-xs font-semibold text-[var(--ink)]">1. Initial Asset Purchase Cost ($)</label>
      <input type="number" id="cost-val" value="50000" min="100" step="2500" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs text-[var(--ink)]" />
    </div>

    <div class="grid grid-cols-2 gap-3 text-xs">
      <div>
        <label for="salvage-val" class="block text-[var(--ink-soft)] mb-1">Salvage Value ($)</label>
        <input type="number" id="salvage-val" value="5000" min="0" step="500" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="life-yrs" class="block text-[var(--ink-soft)] mb-1">Useful Life (Years)</label>
        <input type="number" id="life-yrs" value="5" min="1"  step="1" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
    </div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>Total Depreciable Base:</span><span id="res-p1" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between"><span>Year 1 Depreciation Expense:</span><span id="res-p2" class="font-bold text-emerald-200">$0.00</span></div>
    <div class="flex justify-between"><span>Ending Book Value at Year 1:</span><span id="res-p3" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between pt-1 border-t border-emerald-800/60 font-bold text-white"><span>Final Salvage Residual Value:</span><span id="res-p4">$0.00</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Asset Depreciation Allocation" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>Straight-Line = (Cost - Salvage) / Useful Life. Double Declining = Book Value × (2 / Useful Life).</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>$50,000 initial asset cost with $5,000 salvage value over 5 years yields $9,000 annual straight-line depreciation expense ($45,000 total depreciable base).</p>
  </div>
</CalculatorShell>

<script>
  import { formatCurrency } from '../../scripts/finance.js';
  import { renderDonutChart } from '../../scripts/charts.js';

  function update() {
    try {
      const method = (document.getElementById('method-select') as HTMLSelectElement)?.value || 'straight';
      const cost = parseFloat((document.getElementById('cost-val') as HTMLInputElement)?.value || '50000');
      const salvage = parseFloat((document.getElementById('salvage-val') as HTMLInputElement)?.value || '5000');
      const yrs = parseInt((document.getElementById('life-yrs') as HTMLInputElement)?.value || '5');

      const depreciableBase = Math.max(0, cost - salvage);

      let yr1Expense = 0;
      if (method === 'straight') {
        yr1Expense = depreciableBase / yrs;
      } else if (method === 'db200') {
        const rate = 2 / yrs;
        yr1Expense = Math.min(cost * rate, depreciableBase);
      } else if (method === 'db150') {
        const rate = 1.5 / yrs;
        yr1Expense = Math.min(cost * rate, depreciableBase);
      } else if (method === 'syd') {
        const sydSum = (yrs * (yrs + 1)) / 2;
        yr1Expense = depreciableBase * (yrs / sydSum);
      }

      const yr1EndingBookValue = cost - yr1Expense;

      (document.getElementById('hero-result-value') as HTMLElement).textContent = formatCurrency(yr1Expense);
      (document.getElementById('res-p1') as HTMLElement).textContent = formatCurrency(depreciableBase);
      (document.getElementById('res-p2') as HTMLElement).textContent = formatCurrency(yr1Expense) + '/yr';
      (document.getElementById('res-p3') as HTMLElement).textContent = formatCurrency(yr1EndingBookValue);
      (document.getElementById('res-p4') as HTMLElement).textContent = formatCurrency(salvage);

      const canvas = document.getElementById('calc-chart') as HTMLCanvasElement;
      if (canvas) {
        renderDonutChart(canvas, ['Year 1 Depreciation Expense', 'Remaining Book Value', 'Residual Salvage Value'], [yr1Expense, yr1EndingBookValue - salvage, salvage]);
      }
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
