---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="Currency Calculator"
  description="Convert foreign exchange values across major global currencies using real-time benchmark rates and custom rate adjustments."
  category="Other Financial Calculators"
  categoryHref="/#other"
  resultLabel="Converted Target Currency Value"
  resultSuffix=""
>
  <div slot="inputs" class="space-y-4">
    <div class="space-y-1.5 border-b border-[var(--rule-light)] pb-3">
      <label for="amount-val" class="block text-xs font-semibold text-[var(--ink)]">1. Amount to Convert</label>
      <input type="number" id="amount-val" value="1000" min="1" step="100" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs text-[var(--ink)]" />
    </div>

    <div class="grid grid-cols-2 gap-3 border-b border-[var(--rule-light)] pb-3 text-xs">
      <div>
        <label for="from-curr" class="block text-[var(--ink-soft)] mb-1">From Currency</label>
        <select id="from-curr" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-[var(--ink)] font-mono text-xs">
          <option value="USD" selected>USD - US Dollar</option>
          <option value="EUR">EUR - Euro</option>
          <option value="GBP">GBP - British Pound</option>
          <option value="CAD">CAD - Canadian Dollar</option>
          <option value="AUD">AUD - Australian Dollar</option>
          <option value="JPY">JPY - Japanese Yen</option>
          <option value="INR">INR - Indian Rupee</option>
        </select>
      </div>
      <div>
        <label for="to-curr" class="block text-[var(--ink-soft)] mb-1">To Currency</label>
        <select id="to-curr" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-[var(--ink)] font-mono text-xs">
          <option value="EUR" selected>EUR - Euro</option>
          <option value="USD">USD - US Dollar</option>
          <option value="GBP">GBP - British Pound</option>
          <option value="CAD">CAD - Canadian Dollar</option>
          <option value="AUD">AUD - Australian Dollar</option>
          <option value="JPY">JPY - Japanese Yen</option>
          <option value="INR">INR - Indian Rupee</option>
        </select>
      </div>
    </div>

    <div class="space-y-1 text-xs">
      <label for="custom-rate" class="block text-[var(--ink-soft)] mb-1">Custom Exchange Rate Override (Optional)</label>
      <input type="number" id="custom-rate" placeholder="Auto benchmark" min="0.0001" step="0.0001" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs text-[var(--ink)]" />
    </div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>Converted Value:</span><span id="res-p1" class="font-bold text-emerald-200">€920.00</span></div>
    <div class="flex justify-between"><span>Applied Exchange Rate:</span><span id="res-p2" class="font-bold text-white">1 USD = 0.9200 EUR</span></div>
    <div class="flex justify-between pt-1 border-t border-emerald-800/60 font-bold text-white"><span>Inverse Exchange Rate:</span><span id="res-p3">1 EUR = 1.0870 USD</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Currency Conversion Proportions" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>Target Amount = Base Amount × Exchange Rate. Standard FX rates calibrated against USD central parity benchmark.</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>1,000 USD converted to EUR at benchmark rate of 0.9200 yields €920.00 EUR.</p>
  </div>
</CalculatorShell>

<script>
  import { renderDonutChart } from '../../scripts/charts.js';

  const RATES_TO_USD: Record<string, number> = {
    USD: 1.0,
    EUR: 1.087,
    GBP: 1.285,
    CAD: 0.735,
    AUD: 0.665,
    JPY: 0.00645,
    INR: 0.0120
  };

  const SYMBOLS: Record<string, string> = {
    USD: '$', EUR: '€', GBP: '£', CAD: 'CA$', AUD: 'A$', JPY: '¥', INR: '₹'
  };

  function update() {
    try {
      const amount = parseFloat((document.getElementById('amount-val') as HTMLInputElement)?.value || '1000');
      const fromCurr = (document.getElementById('from-curr') as HTMLSelectElement)?.value || 'USD';
      const toCurr = (document.getElementById('to-curr') as HTMLSelectElement)?.value || 'EUR';
      const customRateInput = (document.getElementById('custom-rate') as HTMLInputElement)?.value;

      let appliedRate = 1.0;

      if (customRateInput && parseFloat(customRateInput) > 0) {
        appliedRate = parseFloat(customRateInput);
      } else {
        const fromUsd = RATES_TO_USD[fromCurr] || 1.0;
        const toUsd = RATES_TO_USD[toCurr] || 1.0;
        appliedRate = fromUsd / toUsd;
      }

      const convertedVal = amount * appliedRate;
      const inverseRate = appliedRate > 0 ? 1 / appliedRate : 0;

      const fromSymbol = SYMBOLS[fromCurr] || '$';
      const toSymbol = SYMBOLS[toCurr] || '€';

      (document.getElementById('hero-result-value') as HTMLElement).textContent = `${toSymbol}${convertedVal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ${toCurr}`;
      (document.getElementById('res-p1') as HTMLElement).textContent = `${toSymbol}${convertedVal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ${toCurr}`;
      (document.getElementById('res-p2') as HTMLElement).textContent = `1 ${fromCurr} = ${appliedRate.toFixed(4)} ${toCurr}`;
      (document.getElementById('res-p3') as HTMLElement).textContent = `1 ${toCurr} = ${inverseRate.toFixed(4)} ${fromCurr}`;

      const canvas = document.getElementById('calc-chart') as HTMLCanvasElement;
      if (canvas) {
        renderDonutChart(canvas, [`Original (${fromCurr})`, `Converted (${toCurr})`], [amount, convertedVal]);
      }
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
