---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="Inflation Calculator"
  description="Calculate the eroded purchasing power of money over time and estimate cumulative price level increases across future or historical years."
  category="Other Financial Calculators"
  categoryHref="/#other"
  resultLabel="Purchasing Power Adjusted Value"
  resultSuffix="equivalent value"
>
  <div slot="inputs" class="space-y-4">
    <div class="space-y-1.5 border-b border-[var(--rule-light)] pb-3">
      <label for="amount-val" class="block text-xs font-semibold text-[var(--ink)]">1. Starting Capital Balance ($)</label>
      <input type="number" id="amount-val" value="10000" min="100" step="500" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs text-[var(--ink)]" />
    </div>

    <div class="grid grid-cols-2 gap-3 border-b border-[var(--rule-light)] pb-3 text-xs">
      <div>
        <label for="rate-val" class="block text-[var(--ink-soft)] mb-1">Inflation Rate (%/yr)</label>
        <input type="number" id="rate-val" value="3.2" min="0" max="25" step="0.1" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="years-val" class="block text-[var(--ink-soft)] mb-1">Time Horizon (Years)</label>
        <input type="number" id="years-val" value="10" min="1" max="50" step="1" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
    </div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>Future Cost Equivalent:</span><span id="res-p1" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between"><span>Real Purchasing Power Loss:</span><span id="res-p2" class="font-bold text-emerald-200">-$0.00</span></div>
    <div class="flex justify-between pt-1 border-t border-emerald-800/60 font-bold text-white"><span>Cumulative Inflation Increase:</span><span id="res-p3">0.0%</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Purchasing Power Real Asset Loss" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>Future Price = Present Amount × (1 + i)^t. Real Purchasing Power = Present Amount / (1 + i)^t.</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>$10,000 at a 3.2% annual inflation rate over 10 years requires $13,702 in 10 years to buy what $10,000 buys today (a 37.0% cumulative price increase).</p>
  </div>
</CalculatorShell>

<script>
  import { formatCurrency, formatPercent } from '../../scripts/finance.js';
  import { renderDonutChart } from '../../scripts/charts.js';

  function update() {
    try {
      const amount = parseFloat((document.getElementById('amount-val') as HTMLInputElement)?.value || '10000');
      const rate = parseFloat((document.getElementById('rate-val') as HTMLInputElement)?.value || '3.2');
      const yrs = parseInt((document.getElementById('years-val') as HTMLInputElement)?.value || '10');

      const inflationFactor = Math.pow(1 + rate / 100, yrs);
      const futurePriceEquivalent = amount * inflationFactor;
      const realValueToday = amount / inflationFactor;

      const purchasingPowerLoss = amount - realValueToday;
      const cumulativeIncreasePct = (inflationFactor - 1) * 100;

      (document.getElementById('hero-result-value') as HTMLElement).textContent = formatCurrency(futurePriceEquivalent);
      (document.getElementById('res-p1') as HTMLElement).textContent = formatCurrency(futurePriceEquivalent);
      (document.getElementById('res-p2') as HTMLElement).textContent = `-${formatCurrency(purchasingPowerLoss)}`;
      (document.getElementById('res-p3') as HTMLElement).textContent = formatPercent(cumulativeIncreasePct, 1);

      const canvas = document.getElementById('calc-chart') as HTMLCanvasElement;
      if (canvas) {
        renderDonutChart(canvas, ['Retained Purchasing Power', 'Purchasing Power Loss to Inflation'], [realValueToday, purchasingPowerLoss]);
      }
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
