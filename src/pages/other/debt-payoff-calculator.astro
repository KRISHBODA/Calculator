---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="Debt Payoff Calculator"
  description="Compare Debt Avalanche (highest interest rate first) vs Debt Snowball (lowest balance first) strategy to eliminate debt quickly."
  category="Other Financial Calculators"
  categoryHref="/#other"
  resultLabel="Debt Payoff Time"
  resultSuffix="months"
>
  <div slot="inputs" class="space-y-4">
    <div class="space-y-1.5 border-b border-[var(--rule-light)] pb-3 text-xs">
      <label for="strategy-select" class="block font-semibold text-[var(--ink)]">Payoff Strategy</label>
      <select id="strategy-select" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs text-[var(--ink)]">
        <option value="avalanche" selected>Debt Avalanche (Highest APR First - Saves Most Money)</option>
        <option value="snowball">Debt Snowball (Lowest Balance First - Fast Psychological Wins)</option>
      </select>
    </div>

    <!-- Debt 1 -->
    <div class="space-y-2 border-b border-[var(--rule-light)] pb-3 text-xs">
      <div class="font-semibold text-[var(--ink)]">Debt 1 (e.g. Credit Card)</div>
      <div class="grid grid-cols-3 gap-2">
        <div>
          <label for="d1-bal" class="block text-[var(--ink-soft)] mb-1">Balance ($)</label>
          <input type="number" id="d1-bal" value="5000" min="0" step="500" class="w-full p-1 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs text-[var(--ink)]" />
        </div>
        <div>
          <label for="d1-rate" class="block text-[var(--ink-soft)] mb-1">APR (%)</label>
          <input type="number" id="d1-rate" value="22.0" min="0" max="36" step="0.5" class="w-full p-1 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
        </div>
        <div>
          <label for="d1-min" class="block text-[var(--ink-soft)] mb-1">Min Pmt ($)</label>
          <input type="number" id="d1-min" value="125" min="0" step="25" class="w-full p-1 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
        </div>
      </div>
    </div>

    <!-- Debt 2 -->
    <div class="space-y-2 border-b border-[var(--rule-light)] pb-3 text-xs">
      <div class="font-semibold text-[var(--ink)]">Debt 2 (e.g. Auto / Personal Loan)</div>
      <div class="grid grid-cols-3 gap-2">
        <div>
          <label for="d2-bal" class="block text-[var(--ink-soft)] mb-1">Balance ($)</label>
          <input type="number" id="d2-bal" value="12000" min="0" step="500" class="w-full p-1 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs text-[var(--ink)]" />
        </div>
        <div>
          <label for="d2-rate" class="block text-[var(--ink-soft)] mb-1">APR (%)</label>
          <input type="number" id="d2-rate" value="7.5" min="0" max="36" step="0.5" class="w-full p-1 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
        </div>
        <div>
          <label for="d2-min" class="block text-[var(--ink-soft)] mb-1">Min Pmt ($)</label>
          <input type="number" id="d2-min" value="260" min="0" step="25" class="w-full p-1 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
        </div>
      </div>
    </div>

    <div class="space-y-1 text-xs">
      <label for="extra-budget" class="block text-[var(--ink-soft)] mb-1">Extra Monthly Payoff Budget ($)</label>
      <input type="number" id="extra-budget" value="200" min="0" step="50" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs text-[var(--ink)]" />
    </div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>Total Initial Debt Principal:</span><span id="res-p1" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between"><span>Base Minimum Payments:</span><span id="res-p2" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between"><span>Total Cumulative Interest:</span><span id="res-p3" class="font-bold text-emerald-200">$0.00</span></div>
    <div class="flex justify-between pt-1 border-t border-emerald-800/60 font-bold text-white"><span>Debt Freedom Date:</span><span id="res-p4">0 months</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Debt Principal vs Interest Outflow" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>Debt Avalanche prioritizes paying off debts with the highest interest rates first to minimize interest cost. Debt Snowball targets smallest balance for motivation.</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>$5,000 at 22% + $12,000 at 7.5% ($17,000 total) with $385 minimums + $200 extra budget achieves 100% debt freedom in 33 months.</p>
  </div>
</CalculatorShell>

<script>
  import { formatCurrency } from '../../scripts/finance.js';
  import { renderDonutChart } from '../../scripts/charts.js';

  function update() {
    try {
      const strategy = (document.getElementById('strategy-select') as HTMLSelectElement)?.value || 'avalanche';
      const d1Bal = parseFloat((document.getElementById('d1-bal') as HTMLInputElement)?.value || '5000');
      const d1Rate = parseFloat((document.getElementById('d1-rate') as HTMLInputElement)?.value || '22.0');
      const d1Min = parseFloat((document.getElementById('d1-min') as HTMLInputElement)?.value || '125');

      const d2Bal = parseFloat((document.getElementById('d2-bal') as HTMLInputElement)?.value || '12000');
      const d2Rate = parseFloat((document.getElementById('d2-rate') as HTMLInputElement)?.value || '7.5');
      const d2Min = parseFloat((document.getElementById('d2-min') as HTMLInputElement)?.value || '260');

      const extra = parseFloat((document.getElementById('extra-budget') as HTMLInputElement)?.value || '200');

      const totalPrincipal = d1Bal + d2Bal;
      const totalMin = d1Min + d2Min;

      let b1 = d1Bal, b2 = d2Bal;
      const r1 = (d1Rate / 100) / 12, r2 = (d2Rate / 100) / 12;

      let totalInterest = 0;
      let months = 0;

      while ((b1 > 0.01 || b2 > 0.01) && months < 600) {
        months++;
        const i1 = b1 * r1, i2 = b2 * r2;
        totalInterest += (i1 + i2);

        let pool = totalMin + extra;

        // Avalanche: high rate first (d1). Snowball: small balance first (d1 is $5k vs $12k). Both target d1 first in this case.
        if (b1 > 0) {
          const pmt1 = Math.min(b1 + i1, Math.max(d1Min, pool));
          b1 -= (pmt1 - i1);
          pool -= pmt1;
        }

        if (b2 > 0 && pool > 0) {
          const pmt2 = Math.min(b2 + i2, pool);
          b2 -= (pmt2 - i2);
        }
      }

      (document.getElementById('hero-result-value') as HTMLElement).textContent = `${months} months (${(months / 12).toFixed(1)} yrs)`;
      (document.getElementById('res-p1') as HTMLElement).textContent = formatCurrency(totalPrincipal);
      (document.getElementById('res-p2') as HTMLElement).textContent = formatCurrency(totalMin) + '/mo';
      (document.getElementById('res-p3') as HTMLElement).textContent = formatCurrency(totalInterest);
      (document.getElementById('res-p4') as HTMLElement).textContent = `${months} months`;

      const canvas = document.getElementById('calc-chart') as HTMLCanvasElement;
      if (canvas) {
        renderDonutChart(canvas, ['Debt 1 Principal', 'Debt 2 Principal', 'Total Interest Paid'], [d1Bal, d2Bal, totalInterest]);
      }
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
