---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="Repayment Calculator"
  description="Calculate how many months and total interest it takes to repay a debt with a fixed monthly repayment budget."
  category="Other Financial Calculators"
  categoryHref="/#other"
  resultLabel="Total Time to Repay Loan"
  resultSuffix="months"
>
  <div slot="inputs" class="space-y-4">
    <div class="space-y-1.5 border-b border-[var(--rule-light)] pb-3">
      <label for="balance-val" class="block text-xs font-semibold text-[var(--ink)]">1. Outstanding Loan Balance ($)</label>
      <input type="number" id="balance-val" value="12000" min="100" step="500" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs text-[var(--ink)]" />
    </div>

    <div class="grid grid-cols-2 gap-3 text-xs">
      <div>
        <label for="rate-val" class="block text-[var(--ink-soft)] mb-1">Interest Rate (%)</label>
        <input type="number" id="rate-val" value="8.5" min="0.1"  step="0.1" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="pmt-val" class="block text-[var(--ink-soft)] mb-1">Monthly Repayment ($)</label>
        <input type="number" id="pmt-val" value="250" min="10" step="25" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
    </div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>Repayment Duration:</span><span id="res-p1" class="font-bold text-white">0 months</span></div>
    <div class="flex justify-between"><span>Total Cumulative Interest:</span><span id="res-p2" class="font-bold text-emerald-200">$0.00</span></div>
    <div class="flex justify-between"><span>Final Payoff Month Payment:</span><span id="res-p3" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between pt-1 border-t border-emerald-800/60 font-bold text-white"><span>Total Outflow Cost:</span><span id="res-p4">$0.00</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Repayment Cost Allocation" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>Months to Repay n = -ln(1 - P*r/PMT) / ln(1+r). Fixed monthly repayment amortizes principal and interest.</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>$12,000 debt at 8.5% interest repaid at $250/month requires 58 months (4.8 years) and $2,425 total interest.</p>
  </div>
</CalculatorShell>

<script>
  import { formatCurrency } from '../../scripts/finance.js';
  import { renderDonutChart } from '../../scripts/charts.js';

  function update() {
    try {
      const p = parseFloat((document.getElementById('balance-val') as HTMLInputElement)?.value || '12000');
      const rate = parseFloat((document.getElementById('rate-val') as HTMLInputElement)?.value || '8.5');
      const pmt = parseFloat((document.getElementById('pmt-val') as HTMLInputElement)?.value || '250');

      const rMo = (rate / 100) / 12;
      const minInterestMo = p * rMo;

      if (pmt <= minInterestMo) {
        (document.getElementById('hero-result-value') as HTMLElement).textContent = 'Repayment too low';
        return;
      }

      let balance = p;
      let totalInterest = 0;
      let months = 0;
      let finalPmt = pmt;

      while (balance > 0.01 && months < 600) {
        months++;
        const iMo = balance * rMo;
        const actualPmt = Math.min(pmt, balance + iMo);
        const prinMo = actualPmt - iMo;

        totalInterest += iMo;
        balance -= prinMo;
        finalPmt = actualPmt;
      }

      (document.getElementById('hero-result-value') as HTMLElement).textContent = `${months} months (${(months / 12).toFixed(1)} yrs)`;
      (document.getElementById('res-p1') as HTMLElement).textContent = `${months} months`;
      (document.getElementById('res-p2') as HTMLElement).textContent = formatCurrency(totalInterest);
      (document.getElementById('res-p3') as HTMLElement).textContent = formatCurrency(finalPmt);
      (document.getElementById('res-p4') as HTMLElement).textContent = formatCurrency(p + totalInterest);

      const canvas = document.getElementById('calc-chart') as HTMLCanvasElement;
      if (canvas) {
        renderDonutChart(canvas, ['Principal Debt Amount', 'Total Interest'], [p, totalInterest]);
      }
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
