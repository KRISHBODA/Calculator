---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="Loan Calculator"
  description="Calculate monthly loan payments, total interest costs, loan payoff timelines, and amortization with optional extra principal payments."
  category="Other Financial Calculators"
  categoryHref="/#other"
  resultLabel="Monthly Loan Payment"
  resultSuffix="/mo"
>
  <div slot="inputs" class="space-y-4">
    <div class="space-y-1.5 border-b border-[var(--rule-light)] pb-3">
      <label for="amount-val" class="block text-xs font-semibold text-[var(--ink)]">1. Loan Amount ($)</label>
      <input type="number" id="amount-val" value="20000" min="500" step="1000" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs text-[var(--ink)]" />
    </div>

    <div class="grid grid-cols-2 gap-3 border-b border-[var(--rule-light)] pb-3 text-xs">
      <div>
        <label for="rate-val" class="block text-[var(--ink-soft)] mb-1">Interest Rate (%)</label>
        <input type="number" id="rate-val" value="7.5" min="0.1"  step="0.1" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="yrs-val" class="block text-[var(--ink-soft)] mb-1">Loan Term (Years)</label>
        <input type="number" id="yrs-val" value="5" min="1"  step="1" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
    </div>

    <div class="space-y-2 text-xs">
      <div class="font-semibold text-[var(--ink-soft)] uppercase tracking-wider">Extra Principal Payments</div>
      <div class="grid grid-cols-2 gap-2">
        <div>
          <label for="extra-mo" class="block text-[var(--ink-soft)] mb-1">Extra Monthly ($)</label>
          <input type="number" id="extra-mo" value="50" min="0" step="25" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
        </div>
        <div>
          <label for="extra-yr" class="block text-[var(--ink-soft)] mb-1">Extra Yearly ($)</label>
          <input type="number" id="extra-yr" value="0" min="0" step="100" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
        </div>
      </div>
    </div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>Scheduled Monthly Payment:</span><span id="res-p1" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between"><span>Total Interest Paid:</span><span id="res-p2" class="font-bold text-emerald-200">$0.00</span></div>
    <div class="flex justify-between"><span>Actual Payoff Time:</span><span id="res-p3" class="font-bold text-white">0 months</span></div>
    <div class="flex justify-between pt-1 border-t border-emerald-800/60 font-bold text-white"><span>Total Outflow:</span><span id="res-p4">$0.00</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Loan Outflow Allocation" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>Monthly Payment M = P * [r(1+r)^n] / [(1+r)^n - 1]. Extra principal accelerates payoff timeline and reduces total interest.</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>$20,000 loan at 7.5% over 5 years yields $400.76/month ($4,045 total interest). Adding $50/month extra pays off loan 7 months early and saves $492 interest.</p>
  </div>
</CalculatorShell>

<script>
  import { amortizedPayment, formatCurrency } from '../../scripts/finance.js';
  import { renderDonutChart } from '../../scripts/charts.js';

  function update() {
    try {
      const p = parseFloat((document.getElementById('amount-val') as HTMLInputElement)?.value || '20000');
      const rate = parseFloat((document.getElementById('rate-val') as HTMLInputElement)?.value || '7.5');
      const yrs = parseInt((document.getElementById('yrs-val') as HTMLInputElement)?.value || '5');
      const extraMo = parseFloat((document.getElementById('extra-mo') as HTMLInputElement)?.value || '50');
      const extraYr = parseFloat((document.getElementById('extra-yr') as HTMLInputElement)?.value || '0');

      const months = yrs * 12;
      const baseMonthlyPmt = amortizedPayment(p, rate, months);

      let balance = p;
      let totalInterest = 0;
      let mCount = 0;
      const rMo = (rate / 100) / 12;

      while (balance > 0.01 && mCount < 600) {
        mCount++;
        const interestMo = balance * rMo;
        let pmt = baseMonthlyPmt + extraMo;
        if (mCount % 12 === 1 && mCount > 1) pmt += extraYr;

        const maxNeed = balance + interestMo;
        const actualPmt = Math.min(pmt, maxNeed);
        const prinMo = actualPmt - interestMo;

        totalInterest += interestMo;
        balance -= prinMo;
      }

      (document.getElementById('hero-result-value') as HTMLElement).textContent = formatCurrency(baseMonthlyPmt);
      (document.getElementById('res-p1') as HTMLElement).textContent = formatCurrency(baseMonthlyPmt) + '/mo';
      (document.getElementById('res-p2') as HTMLElement).textContent = formatCurrency(totalInterest);
      (document.getElementById('res-p3') as HTMLElement).textContent = `${mCount} months (${(mCount / 12).toFixed(1)} yrs)`;
      (document.getElementById('res-p4') as HTMLElement).textContent = formatCurrency(p + totalInterest);

      const canvas = document.getElementById('calc-chart') as HTMLCanvasElement;
      if (canvas) {
        renderDonutChart(canvas, ['Principal Loan Amount', 'Total Interest'], [p, totalInterest]);
      }
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
