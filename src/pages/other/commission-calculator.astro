---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="Commission Calculator"
  description="Calculate total sales commission payouts, tiered incentive structures, and gross earnings for sales professionals."
  category="Other Financial Calculators"
  categoryHref="/#other"
  resultLabel="Total Gross Earnings"
  resultSuffix="total"
>
  <div slot="inputs" class="space-y-4">
    <div class="space-y-1.5 border-b border-[var(--rule-light)] pb-3">
      <label for="sales-val" class="block text-xs font-semibold text-[var(--ink)]">1. Total Sales Revenue Generated ($)</label>
      <input type="number" id="sales-val" value="150000" min="1000" step="10000" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs text-[var(--ink)]" />
    </div>

    <div class="grid grid-cols-2 gap-3 border-b border-[var(--rule-light)] pb-3 text-xs">
      <div>
        <label for="base-salary" class="block text-[var(--ink-soft)] mb-1">Base Salary ($)</label>
        <input type="number" id="base-salary" value="40000" min="0" step="2500" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="comm-rate" class="block text-[var(--ink-soft)] mb-1">Commission Rate (%)</label>
        <input type="number" id="comm-rate" value="6.5" min="0"  step="0.5" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
    </div>

    <div class="space-y-1 text-xs">
      <label for="bonus-threshold" class="block text-[var(--ink-soft)] mb-1">Tiered Bonus Quota Target ($)</label>
      <input type="number" id="bonus-threshold" value="100000" min="0" step="10000" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs text-[var(--ink)]" />
    </div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>Base Salary Component:</span><span id="res-p1" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between"><span>Commission Earned:</span><span id="res-p2" class="font-bold text-emerald-200">$0.00</span></div>
    <div class="flex justify-between"><span>Over-Quota Performance Bonus:</span><span id="res-p3" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between pt-1 border-t border-emerald-800/60 font-bold text-white"><span>Effective Overall Pay Rate:</span><span id="res-p4">0.0%</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Gross Compensation Breakdown" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>Gross Earnings = Base Salary + (Sales Revenue × Commission%) + Over-Quota Tiered Bonuses.</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>$150,000 sales revenue with $40,000 base salary at 6.5% commission yields $9,750 commission ($49,750 total gross earnings).</p>
  </div>
</CalculatorShell>

<script>
  import { formatCurrency, formatPercent } from '../../scripts/finance.js';
  import { renderDonutChart } from '../../scripts/charts.js';

  function update() {
    try {
      const sales = parseFloat((document.getElementById('sales-val') as HTMLInputElement)?.value || '150000');
      const baseSalary = parseFloat((document.getElementById('base-salary') as HTMLInputElement)?.value || '40000');
      const ratePct = parseFloat((document.getElementById('comm-rate') as HTMLInputElement)?.value || '6.5') / 100;
      const threshold = parseFloat((document.getElementById('bonus-threshold') as HTMLInputElement)?.value || '100000');

      const baseCommission = sales * ratePct;

      let overQuotaBonus = 0;
      if (sales > threshold) {
        const excess = sales - threshold;
        overQuotaBonus = excess * 0.03; // 3% accelerators
      }

      const totalCommission = baseCommission + overQuotaBonus;
      const totalEarnings = baseSalary + totalCommission;
      const effectivePayRate = sales > 0 ? (totalEarnings / sales) * 100 : 0;

      (document.getElementById('hero-result-value') as HTMLElement).textContent = formatCurrency(totalEarnings);
      (document.getElementById('res-p1') as HTMLElement).textContent = formatCurrency(baseSalary);
      (document.getElementById('res-p2') as HTMLElement).textContent = formatCurrency(baseCommission);
      (document.getElementById('res-p3') as HTMLElement).textContent = formatCurrency(overQuotaBonus);
      (document.getElementById('res-p4') as HTMLElement).textContent = formatPercent(effectivePayRate, 1);

      const canvas = document.getElementById('calc-chart') as HTMLCanvasElement;
      if (canvas) {
        renderDonutChart(canvas, ['Base Salary', 'Commission Earned', 'Over-Quota Bonus'], [baseSalary, baseCommission, overQuotaBonus]);
      }
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
