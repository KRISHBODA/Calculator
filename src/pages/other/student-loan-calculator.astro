---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="Student Loan Calculator"
  description="Calculate monthly student loan payments across standard 10-year repayment plans, extended terms, and post-graduation grace periods."
  category="Other Financial Calculators"
  categoryHref="/#other"
  resultLabel="Monthly Student Loan Payment"
  resultSuffix="/mo"
>
  <div slot="inputs" class="space-y-4">
    <div class="space-y-1.5 border-b border-[var(--rule-light)] pb-3">
      <label for="balance-val" class="block text-xs font-semibold text-[var(--ink)]">1. Total Student Loan Debt ($)</label>
      <input type="number" id="balance-val" value="35000" min="1000" step="2500" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs text-[var(--ink)]" />
    </div>

    <div class="grid grid-cols-2 gap-3 border-b border-[var(--rule-light)] pb-3 text-xs">
      <div>
        <label for="rate-val" class="block text-[var(--ink-soft)] mb-1">Interest Rate (%)</label>
        <input type="number" id="rate-val" value="5.5" min="0.1"  step="0.1" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="term-yrs" class="block text-[var(--ink-soft)] mb-1">Repayment Term (Years)</label>
        <input type="number" id="term-yrs" value="10" min="5"  step="5" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
    </div>

    <div class="space-y-1 text-xs">
      <label for="grace-months" class="block text-[var(--ink-soft)] mb-1">Post-Graduation Grace Period (Months)</label>
      <input type="number" id="grace-months" value="6" min="0"  step="1" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs text-[var(--ink)]" />
    </div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>Monthly Payment (Standard Plan):</span><span id="res-p1" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between"><span>Interest Accrued During Grace Period:</span><span id="res-p2" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between"><span>Total Cumulative Interest:</span><span id="res-p3" class="font-bold text-emerald-200">$0.00</span></div>
    <div class="flex justify-between pt-1 border-t border-emerald-800/60 font-bold text-white"><span>Total Lifetime Outflow Cost:</span><span id="res-p4">$0.00</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Student Loan Principal vs Interest" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>Interest accrued during the grace period capitalizes into principal at repayment start unless paid off beforehand.</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>$35,000 federal loan at 5.5% over 10 years with 6-month grace period accrues $962.50 interest, resulting in $388.94/month ($11,673 total interest).</p>
  </div>
</CalculatorShell>

<script>
  import { amortizedPayment, formatCurrency } from '../../scripts/finance.js';
  import { renderDonutChart } from '../../scripts/charts.js';

  function update() {
    try {
      const balance = parseFloat((document.getElementById('balance-val') as HTMLInputElement)?.value || '35000');
      const rate = parseFloat((document.getElementById('rate-val') as HTMLInputElement)?.value || '5.5');
      const termYrs = parseInt((document.getElementById('term-yrs') as HTMLInputElement)?.value || '10');
      const graceMonths = parseInt((document.getElementById('grace-months') as HTMLInputElement)?.value || '6');

      const rMo = (rate / 100) / 12;
      const graceInterest = balance * rMo * graceMonths;
      const capitalizedPrincipal = balance + graceInterest;

      const totalMonths = termYrs * 12;
      const monthlyPmt = amortizedPayment(capitalizedPrincipal, rate, totalMonths);
      const totalOutflow = monthlyPmt * totalMonths;
      const totalInterest = totalOutflow - balance;

      (document.getElementById('hero-result-value') as HTMLElement).textContent = formatCurrency(monthlyPmt);
      (document.getElementById('res-p1') as HTMLElement).textContent = formatCurrency(monthlyPmt) + '/mo';
      (document.getElementById('res-p2') as HTMLElement).textContent = formatCurrency(graceInterest);
      (document.getElementById('res-p3') as HTMLElement).textContent = formatCurrency(totalInterest);
      (document.getElementById('res-p4') as HTMLElement).textContent = formatCurrency(totalOutflow);

      const canvas = document.getElementById('calc-chart') as HTMLCanvasElement;
      if (canvas) {
        renderDonutChart(canvas, ['Initial Debt Principal', 'Grace Period Interest', 'Repayment Interest'], [balance, graceInterest, totalInterest - graceInterest]);
      }
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
