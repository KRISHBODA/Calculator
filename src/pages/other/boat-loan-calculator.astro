---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="Boat Loan Calculator"
  description="Calculate marine boat loan monthly payments, sales tax, down payment options, and total ownership costs including annual maintenance & insurance."
  category="Other Financial Calculators"
  categoryHref="/#other"
  resultLabel="Monthly Boat Payment"
  resultSuffix="/mo"
>
  <div slot="inputs" class="space-y-4">
    <div class="space-y-1.5 border-b border-[var(--rule-light)] pb-3">
      <label for="price-val" class="block text-xs font-semibold text-[var(--ink)]">1. Boat Purchase Price ($)</label>
      <input type="number" id="price-val" value="45000" min="2000" step="2500" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs text-[var(--ink)]" />
    </div>

    <div class="grid grid-cols-2 gap-3 border-b border-[var(--rule-light)] pb-3 text-xs">
      <div>
        <label for="down-pct" class="block text-[var(--ink-soft)] mb-1">Down Payment (%)</label>
        <input type="number" id="down-pct" value="15" min="0" max="50" step="5" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="rate-val" class="block text-[var(--ink-soft)] mb-1">Interest Rate (%)</label>
        <input type="number" id="rate-val" value="7.25" min="0.1" max="20" step="0.1" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
    </div>

    <div class="grid grid-cols-3 gap-2 text-xs">
      <div>
        <label for="term-yrs" class="block text-[var(--ink-soft)] mb-1">Term (Yrs)</label>
        <input type="number" id="term-yrs" value="10" min="1" max="20" step="1" class="w-full p-1 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="tax-rate" class="block text-[var(--ink-soft)] mb-1">Sales Tax (%)</label>
        <input type="number" id="tax-rate" value="6.5" min="0" max="15" step="0.5" class="w-full p-1 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="maint-val" class="block text-[var(--ink-soft)] mb-1">Ins/Maint ($/yr)</label>
        <input type="number" id="maint-val" value="1800" min="0" step="250" class="w-full p-1 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-[var(--ink)]" />
      </div>
    </div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>Monthly Loan Principal & Interest:</span><span id="res-p1" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between"><span>Down Payment Cash Outflow:</span><span id="res-p2" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between"><span>Sales Tax Outflow:</span><span id="res-p3" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between pt-1 border-t border-emerald-800/60 font-bold text-white"><span>Total Monthly Cost (Inc Maint & Ins):</span><span id="res-p4" class="text-emerald-200">$0.00/mo</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Total Boat Ownership Cost Structure" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>Boat Loan Principal = Price × (1 - Down%) + Sales Tax. Amortized over marine financing terms (10-20 years).</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>$45,000 boat with 15% down ($6,750) and 6.5% sales tax ($2,925) at 7.25% over 10 years yields $482.52/mo loan payment ($632.52/mo total with maintenance & insurance).</p>
  </div>
</CalculatorShell>

<script>
  import { amortizedPayment, formatCurrency } from '../../scripts/finance.js';
  import { renderDonutChart } from '../../scripts/charts.js';

  function update() {
    try {
      const price = parseFloat((document.getElementById('price-val') as HTMLInputElement)?.value || '45000');
      const downPct = parseFloat((document.getElementById('down-pct') as HTMLInputElement)?.value || '15') / 100;
      const rate = parseFloat((document.getElementById('rate-val') as HTMLInputElement)?.value || '7.25');
      const termYrs = parseInt((document.getElementById('term-yrs') as HTMLInputElement)?.value || '10');
      const taxRate = parseFloat((document.getElementById('tax-rate') as HTMLInputElement)?.value || '6.5') / 100;
      const annualMaint = parseFloat((document.getElementById('maint-val') as HTMLInputElement)?.value || '1800');

      const downPayment = price * downPct;
      const salesTax = price * taxRate;
      const loanAmount = Math.max(0, price - downPayment + salesTax);

      const months = termYrs * 12;
      const monthlyPmt = amortizedPayment(loanAmount, rate, months);
      const monthlyMaint = annualMaint / 12;
      const totalMonthlyCost = monthlyPmt + monthlyMaint;

      const totalInterest = (monthlyPmt * months) - loanAmount;

      (document.getElementById('hero-result-value') as HTMLElement).textContent = formatCurrency(monthlyPmt);
      (document.getElementById('res-p1') as HTMLElement).textContent = formatCurrency(monthlyPmt) + '/mo';
      (document.getElementById('res-p2') as HTMLElement).textContent = formatCurrency(downPayment);
      (document.getElementById('res-p3') as HTMLElement).textContent = formatCurrency(salesTax);
      (document.getElementById('res-p4') as HTMLElement).textContent = formatCurrency(totalMonthlyCost) + '/mo';

      const canvas = document.getElementById('calc-chart') as HTMLCanvasElement;
      if (canvas) {
        renderDonutChart(canvas, ['Down Payment', 'Loan Principal', 'Interest Paid', 'Maintenance & Insurance'], [downPayment, loanAmount - salesTax, totalInterest, annualMaint * termYrs]);
      }
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
