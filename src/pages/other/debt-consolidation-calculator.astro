---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="Debt Consolidation Calculator"
  description="Determine if combining multiple high-interest credit card debts or loans into a single lower-rate consolidation loan will save money."
  category="Other Financial Calculators"
  categoryHref="/#other"
  resultLabel="Consolidation Monthly Savings"
  resultSuffix="/mo"
>
  <div slot="inputs" class="space-y-4">
    <div class="space-y-1.5 border-b border-[var(--rule-light)] pb-3">
      <label for="debt-total" class="block text-xs font-semibold text-[var(--ink)]">1. Total Existing Debt Balance ($)</label>
      <input type="number" id="debt-total" value="25000" min="1000" step="1000" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs text-[var(--ink)]" />
    </div>

    <div class="grid grid-cols-2 gap-3 border-b border-[var(--rule-light)] pb-3 text-xs">
      <div>
        <label for="cur-rate" class="block text-[var(--ink-soft)] mb-1">Current Avg Interest Rate (%)</label>
        <input type="number" id="cur-rate" value="19.5" min="1"  step="0.5" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="cur-pmt" class="block text-[var(--ink-soft)] mb-1">Current Total Monthly Pmt ($)</label>
        <input type="number" id="cur-pmt" value="700" min="50" step="50" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-[var(--ink)]" />
      </div>
    </div>

    <div class="grid grid-cols-3 gap-2 text-xs">
      <div>
        <label for="new-rate" class="block text-[var(--ink-soft)] mb-1">New Rate (%)</label>
        <input type="number" id="new-rate" value="9.9" min="1"  step="0.1" class="w-full p-1 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="new-term" class="block text-[var(--ink-soft)] mb-1">New Term (Yrs)</label>
        <input type="number" id="new-term" value="4" min="1"  step="1" class="w-full p-1 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="fee-val" class="block text-[var(--ink-soft)] mb-1">Orig Fee ($)</label>
        <input type="number" id="fee-val" value="500" min="0" step="100" class="w-full p-1 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
    </div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>Current Monthly Payment:</span><span id="res-p1" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between"><span>New Consolidated Monthly Payment:</span><span id="res-p2" class="font-bold text-emerald-200">$0.00</span></div>
    <div class="flex justify-between"><span>Monthly Payment Reduction:</span><span id="res-p3" class="font-bold text-white">$0.00/mo</span></div>
    <div class="flex justify-between pt-1 border-t border-emerald-800/60 font-bold text-white"><span>Total Net Financial Savings:</span><span id="res-p4">$0.00</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Current vs Consolidated Total Outflow" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>Consolidation Loan Payment = (Debt Principal + Fees) * [r(1+r)^n] / [(1+r)^n - 1]. Compares overall interest and fees against existing debt payoff schedule.</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>$25,000 existing debt at 19.5% ($700/mo) consolidated into a 4-year loan at 9.9% ($500 fee) reduces monthly payment to $633.24 ($66.76/mo savings) and saves $5,820 total interest.</p>
  </div>
</CalculatorShell>

<script>
  import { amortizedPayment, formatCurrency } from '../../scripts/finance.js';
  import { renderDonutChart } from '../../scripts/charts.js';

  function update() {
    try {
      const debtTotal = parseFloat((document.getElementById('debt-total') as HTMLInputElement)?.value || '25000');
      const curRate = parseFloat((document.getElementById('cur-rate') as HTMLInputElement)?.value || '19.5');
      const curPmt = parseFloat((document.getElementById('cur-pmt') as HTMLInputElement)?.value || '700');

      const newRate = parseFloat((document.getElementById('new-rate') as HTMLInputElement)?.value || '9.9');
      const newTermYrs = parseInt((document.getElementById('new-term') as HTMLInputElement)?.value || '4');
      const fee = parseFloat((document.getElementById('fee-val') as HTMLInputElement)?.value || '500');

      // 1. Current Debt Payoff Simulation
      let balCur = debtTotal;
      let curInterestTotal = 0;
      let curMonths = 0;
      const rCurMo = (curRate / 100) / 12;

      while (balCur > 0.01 && curMonths < 600) {
        curMonths++;
        const iMo = balCur * rCurMo;
        const actualPmt = Math.min(curPmt, balCur + iMo);
        const prinMo = actualPmt - iMo;

        curInterestTotal += iMo;
        balCur -= prinMo;
      }
      const totalCurCost = debtTotal + curInterestTotal;

      // 2. Consolidated Loan
      const consPrincipal = debtTotal + fee;
      const consMonths = newTermYrs * 12;
      const newMonthlyPmt = amortizedPayment(consPrincipal, newRate, consMonths);
      const totalNewCost = newMonthlyPmt * consMonths;
      const totalNewInterest = totalNewCost - consPrincipal;

      const monthlySavings = curPmt - newMonthlyPmt;
      const netTotalSavings = totalCurCost - totalNewCost;

      (document.getElementById('hero-result-value') as HTMLElement).textContent = monthlySavings >= 0 ? `${formatCurrency(monthlySavings)}/mo savings` : `${formatCurrency(Math.abs(monthlySavings))}/mo higher`;
      (document.getElementById('res-p1') as HTMLElement).textContent = formatCurrency(curPmt) + '/mo';
      (document.getElementById('res-p2') as HTMLElement).textContent = formatCurrency(newMonthlyPmt) + '/mo';
      (document.getElementById('res-p3') as HTMLElement).textContent = formatCurrency(monthlySavings) + '/mo';
      (document.getElementById('res-p4') as HTMLElement).textContent = formatCurrency(netTotalSavings);

      const canvas = document.getElementById('calc-chart') as HTMLCanvasElement;
      if (canvas) {
        renderDonutChart(canvas, ['New Consolidation Loan Outflow', 'Total Savings'], [totalNewCost, Math.max(0, netTotalSavings)]);
      }
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
