---
import CalculatorShell from '../../components/CalculatorShell.astro';
import ResultChart from '../../components/ResultChart.astro';
---

<CalculatorShell
  title="Business Loan Calculator"
  description="Calculate commercial business loan payments, SBA origination fee costs, total interest, and debt service coverage ratio (DSCR)."
  category="Other Financial Calculators"
  categoryHref="/#other"
  resultLabel="Monthly Business Loan Payment"
  resultSuffix="/mo"
>
  <div slot="inputs" class="space-y-4">
    <div class="space-y-1.5 border-b border-[var(--rule-light)] pb-3">
      <label for="amount-val" class="block text-xs font-semibold text-[var(--ink)]">1. Business Loan Capital ($)</label>
      <input type="number" id="amount-val" value="150000" min="5000" step="10000" class="w-full p-2 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-xs text-[var(--ink)]" />
    </div>

    <div class="grid grid-cols-2 gap-3 border-b border-[var(--rule-light)] pb-3 text-xs">
      <div>
        <label for="rate-val" class="block text-[var(--ink-soft)] mb-1">Interest Rate (%)</label>
        <input type="number" id="rate-val" value="8.5" min="0.1"  step="0.1" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="term-yrs" class="block text-[var(--ink-soft)] mb-1">Loan Term (Years)</label>
        <input type="number" id="term-yrs" value="7" min="1"  step="1" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
    </div>

    <div class="grid grid-cols-2 gap-3 text-xs">
      <div>
        <label for="fee-pct" class="block text-[var(--ink-soft)] mb-1">Origination / SBA Fee (%)</label>
        <input type="number" id="fee-pct" value="2.5" min="0"  step="0.5" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded text-right font-mono text-[var(--ink)]" />
      </div>
      <div>
        <label for="revenue-val" class="block text-[var(--ink-soft)] mb-1">Annual Revenue ($)</label>
        <input type="number" id="revenue-val" value="400000" min="10000" step="25000" class="w-full p-1.5 bg-[var(--paper)] border border-[var(--rule)] rounded font-mono text-[var(--ink)]" />
      </div>
    </div>
  </div>

  <div slot="result-breakdown" class="space-y-2">
    <div class="flex justify-between"><span>Monthly Debt Payment:</span><span id="res-p1" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between"><span>Upfront Origination Fee Cost:</span><span id="res-p2" class="font-bold text-white">$0.00</span></div>
    <div class="flex justify-between"><span>Total Cumulative Interest:</span><span id="res-p3" class="font-bold text-emerald-200">$0.00</span></div>
    <div class="flex justify-between pt-1 border-t border-emerald-800/60 font-bold text-white"><span>Estimated DSCR Ratio:</span><span id="res-p4">0.0x</span></div>
  </div>

  <div slot="chart">
    <ResultChart id="calc-chart" type="donut" title="Business Loan Outflow Structure" />
  </div>

  <div slot="formula-explanation" class="space-y-2">
    <p>Monthly Payment = Principal × [r(1+r)^n] / [(1+r)^n - 1]. DSCR = Annual Net Income / Annual Debt Payments.</p>
  </div>

  <div slot="worked-example" class="space-y-2 text-xs">
    <p>$150,000 business loan at 8.5% over 7 years requires $2,377.94/month ($49,747 total interest + $3,750 origination fee).</p>
  </div>
</CalculatorShell>

<script>
  import { amortizedPayment, formatCurrency } from '../../scripts/finance.js';
  import { renderDonutChart } from '../../scripts/charts.js';

  function update() {
    try {
      const p = parseFloat((document.getElementById('amount-val') as HTMLInputElement)?.value || '150000');
      const rate = parseFloat((document.getElementById('rate-val') as HTMLInputElement)?.value || '8.5');
      const termYrs = parseInt((document.getElementById('term-yrs') as HTMLInputElement)?.value || '7');
      const feePct = parseFloat((document.getElementById('fee-pct') as HTMLInputElement)?.value || '2.5') / 100;
      const revenue = parseFloat((document.getElementById('revenue-val') as HTMLInputElement)?.value || '400000');

      const months = termYrs * 12;
      const monthlyPmt = amortizedPayment(p, rate, months);
      const totalOutflow = monthlyPmt * months;
      const totalInterest = totalOutflow - p;
      const feeCost = p * feePct;

      const annualDebtService = monthlyPmt * 12;
      const approxEbitda = revenue * 0.20; // 20% margin assumption
      const dscr = annualDebtService > 0 ? approxEbitda / annualDebtService : 0;

      (document.getElementById('hero-result-value') as HTMLElement).textContent = formatCurrency(monthlyPmt);
      (document.getElementById('res-p1') as HTMLElement).textContent = formatCurrency(monthlyPmt) + '/mo';
      (document.getElementById('res-p2') as HTMLElement).textContent = formatCurrency(feeCost);
      (document.getElementById('res-p3') as HTMLElement).textContent = formatCurrency(totalInterest);
      (document.getElementById('res-p4') as HTMLElement).textContent = `${dscr.toFixed(2)}x ${dscr >= 1.25 ? '(Healthy)' : '(Tight)'}`;

      const canvas = document.getElementById('calc-chart') as HTMLCanvasElement;
      if (canvas) {
        renderDonutChart(canvas, ['Principal Loan Capital', 'Interest Paid', 'Upfront Fees'], [p, totalInterest, feeCost]);
      }
    } catch (err) {
      console.error(err);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, select').forEach(el => {
      el.addEventListener('input', update);
      el.addEventListener('change', update);
    });
    update();
  });
</script>
