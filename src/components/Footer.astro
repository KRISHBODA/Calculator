<footer class="border-t border-[var(--rule)] bg-[var(--paper)] py-12 mt-20 transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      <div>
        <h3 class="font-serif text-lg font-bold text-[var(--ink)] mb-2">Ledger Financial Calculators</h3>
        <p class="text-sm text-[var(--ink-soft)] leading-relaxed">
          Free, fast, client-side financial tools designed with clarity and precision. No ads, no sign-ups required.
        </p>
      </div>

      <div>
        <h4 class="text-xs uppercase tracking-wider font-semibold text-[var(--ink-soft)] mb-3">Categories</h4>
        <ul class="space-y-2 text-sm text-[var(--ink-soft)]">
          <li><a href="#mortgage-real-estate" class="hover:text-[var(--ink)] transition-colors">Mortgage & Real Estate</a></li>
          <li><a href="#auto" class="hover:text-[var(--ink)] transition-colors">Auto Loans & Leases</a></li>
          <li><a href="#investment" class="hover:text-[var(--ink)] transition-colors">Investment & Savings</a></li>
          <li><a href="#retirement" class="hover:text-[var(--ink)] transition-colors">Retirement Planning</a></li>
          <li><a href="#tax-and-salary" class="hover:text-[var(--ink)] transition-colors">Tax & Salary</a></li>
          <li><a href="#other" class="hover:text-[var(--ink)] transition-colors">Other Financial Tools</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-xs uppercase tracking-wider font-semibold text-[var(--ink-soft)] mb-3">Disclaimer</h4>
        <p class="text-xs text-[var(--ink-soft)] leading-relaxed">
          Calculations provided are for educational and informational purposes only and do not constitute financial advice. Formula estimates may change with annual tax laws.
        </p>
      </div>
    </div>

    <div class="border-t border-[var(--rule-light)] pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-[var(--ink-soft)]">
      <p>&copy; {new Date().getFullYear()} Free Online Calculator. All rights reserved.</p>
      <p class="mt-2 sm:mt-0">Built with Astro & Tailwind CSS v4</p>
    </div>
  </div>
</footer>
