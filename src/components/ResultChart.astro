---
interface Props {
  id?: string;
  type?: 'donut' | 'line' | 'stackedBar';
  title?: string;
}

const { id = "result-chart-canvas", type = "donut", title = "Breakdown" } = Astro.props;
---

<div class="bg-[var(--paper-raised)] border border-[var(--rule)] rounded-lg p-4 transition-colors">
  {title && (
    <h4 class="text-xs uppercase tracking-wider font-semibold text-[var(--ink-soft)] mb-3 flex items-center justify-between">
      <span>{title}</span>
      <span class="text-[10px] font-mono text-[var(--ink-soft)]">Interactive</span>
    </h4>
  )}
  <div class="relative w-full h-64 sm:h-72">
    <canvas id={id} data-chart-type={type}></canvas>
  </div>
</div>
